{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Throttling": {
    "Register": {
      "HitLimit": 100,
      "DurationSeconds": 60
    },
    "Login": {
      "HitLimit": 100,
      "DurationSeconds": 60
    },
    "Upload": {
      "HitLimit": 100,
      "DurationSeconds": 60
    },
    "Diagnose": {
      "HitLimit": 100,
      "DurationSeconds": 60
    }
  }
}