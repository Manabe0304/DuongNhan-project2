@page "/first-upload"
@page "/onboarding/first-upload"
@inject NavigationService Navigation
@inject UiSessionService Session

<div class="container dn-container" style="max-width: 680px; padding-top: 3rem; padding-bottom: 4rem;">
    <!-- Progress dots -->
    <div class="d-flex justify-content-center gap-2 mb-5">
        <span class="dn-ob-dot" aria-label="Bước 1"></span>
        <span class="dn-ob-dot" aria-label="Bước 2"></span>
        <span class="dn-ob-dot dn-ob-dot--active" aria-label="Bước 3"></span>
    </div>

    <div class="text-center mb-4">
        <span class="dn-kicker">Sẵn sàng chưa?</span>
        <h1 class="mt-2">Thực hiện lần scan đầu tiên</h1>
        <p class="text-secondary">Chỉ mất khoảng 30 giây — AI sẽ phân tích tình trạng da của bạn ngay lập tức.</p>
    </div>

    <!-- Tips grid -->
    <div class="row g-3 mb-5">
        <div class="col-sm-6">
            <div class="dn-tip-card">
                <i class="ph ph-sun" aria-hidden="true"></i>
                <div>
                    <strong>Ánh sáng tự nhiên</strong>
                    <p class="small text-secondary mb-0">Ngồi gần cửa sổ hoặc nơi đủ sáng</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="dn-tip-card">
                <i class="ph ph-face" aria-hidden="true"></i>
                <div>
                    <strong>Mặt sạch, không trang điểm</strong>
                    <p class="small text-secondary mb-0">Rửa mặt nhẹ nhàng trước khi chụp</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="dn-tip-card">
                <i class="ph ph-ruler" aria-hidden="true"></i>
                <div>
                    <strong>Khoảng cách 20–30cm</strong>
                    <p class="small text-secondary mb-0">Giữ camera ổn định, không quá gần</p>
                </div>
            </div>
        </div>
        <div class="col-sm-6">
            <div class="dn-tip-card">
                <i class="ph ph-prohibit" aria-hidden="true"></i>
                <div>
                    <strong>Không dùng filter</strong>
                    <p class="small text-secondary mb-0">Ảnh gốc cho kết quả chính xác hơn</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="dn-card p-4 text-center mb-4" style="border: 2px dashed var(--dn-coral, #e06c4c); background: rgba(224,108,76,.04);">
        <i class="ph ph-camera" style="font-size: 3rem; color: var(--dn-coral, #e06c4c);" aria-hidden="true"></i>
        <p class="mt-3 mb-0 text-secondary small">Nhấn nút bên dưới để chụp ảnh hoặc tải ảnh lên và bắt đầu phân tích.</p>
    </div>

    <div class="d-flex flex-column align-items-center gap-3">
        <a href="/scan" class="btn btn-dn-coral btn-lg px-5 w-100" id="btn-start-first-scan">
            <i class="ph ph-scan me-2" aria-hidden="true"></i> Bắt đầu AI Scan ngay
        </a>
        <div class="d-flex gap-3">
            <a href="/onboarding/how-it-works" class="btn btn-dn-outline" id="btn-back-fu">
                <i class="ph ph-arrow-left me-1" aria-hidden="true"></i> Quay lại
            </a>
            <a href="/dashboard" class="btn btn-dn-outline" id="btn-skip-fu">
                Bỏ qua, vào Dashboard
            </a>
        </div>
    </div>
</div>

<style>
    .dn-ob-dot { width:10px;height:10px;border-radius:50%;background:var(--dn-border,#dee2e6);display:inline-block;transition:background .2s; }
    .dn-ob-dot--active { background:var(--dn-coral,#e06c4c);width:28px;border-radius:5px; }

    .dn-tip-card {
        display:flex;align-items:flex-start;gap:.85rem;
        padding:1rem;border-radius:var(--dn-radius-sm,.6rem);
        border:1px solid var(--dn-border,rgba(0,0,0,.08));
        background:var(--dn-surface,#fff);height:100%;
    }
    .dn-tip-card i { font-size:1.6rem;color:var(--dn-coral,#e06c4c);flex-shrink:0;margin-top:2px; }
</style>
