    /// <summary>Sets visibility for many products (concurrent batches) and offers an undo for 10 seconds.</summary>
    private async Task SetActiveAsync(List<AdminProductDto> targets, bool active, bool recordUndo = true)
    {
        var todo = targets.Where(p => p.IsActive != active).ToList();
        if (todo.Count == 0) { Toasts.ShowSuccess("Không có sản phẩm nào cần thay đổi."); return; }

        busy = true;
        var changed = new List<Guid>();
        var failed = 0;
        try
        {
            foreach (var batch in todo.Chunk(8))
            {
                var results = await Task.WhenAll(batch.Select(async Task<AdminProductDto?> (p) =>
                {
                    try
                    {
                        return await Admin.UpdateProductAsync(p.Id,
                            new SaveAdminProductRequest(null, null, null, null, null, null, null, null, null, null, null, active));
                    }
                    catch { return null; }
                }));

                foreach (var saved in results)
                {
                    if (saved is null) { failed++; continue; }
                    changed.Add(saved.Id);
                    var index = items.FindIndex(x => x.Id == saved.Id);
                    if (index >= 0) items[index] = saved;
                }
                StateHasChanged();
            }
        }
        finally { busy = false; }

        var verb = active ? "hiện" : "ẩn";
        if (failed == 0) Toasts.ShowSuccess($"Đã {verb} {changed.Count} sản phẩm.");
        else Toasts.ShowError($"{verb} thành công {changed.Count}, thất bại {failed} sản phẩm.");

        selected.Clear();
        if (recordUndo && changed.Count > 0)
        {
            undo = new UndoInfo(changed, !active, $"Đã {verb} {changed.Count} sản phẩm.");
            _ = ExpireUndoAsync();
        }
        else if (!recordUndo) undo = null;
    }

    private async Task ExpireUndoAsync()
    {
        var v = ++undoVersion;
        await Task.Delay(TimeSpan.FromSeconds(10));
        if (v != undoVersion) return;
        undo = null;
        await InvokeAsync(StateHasChanged);
    }

    private async Task UndoAsync()
    {
        if (undo is not { } u) return;
        undoVersion++;
        var ids = u.Ids.ToHashSet();
        await SetActiveAsync(items.Where(p => ids.Contains(p.Id)).ToList(), u.Restore, recordUndo: false);
    }

    private async Task DeleteManyAsync(List<AdminProductDto> targets)
    {
        busy = true;
        var failed = 0;
        try
        {
            foreach (var batch in targets.Chunk(8))
            {
                var results = await Task.WhenAll(batch.Select(async p =>
                {
                    try { await Admin.DeleteProductAsync(p.Id); return (Guid?)p.Id; }
                    catch { return null; }
                }));

                foreach (var id in results)
                {
                    if (id is null) { failed++; continue; }
                    items.RemoveAll(x => x.Id == id);
                }
                StateHasChanged();
            }
        }
        finally { busy = false; }

        selected.Clear();
        if (failed == 0) Toasts.ShowSuccess($"Đã xoá {targets.Count} sản phẩm.");
        else Toasts.ShowError($"Xoá thành công {targets.Count - failed}, thất bại {failed} sản phẩm.");
    }

