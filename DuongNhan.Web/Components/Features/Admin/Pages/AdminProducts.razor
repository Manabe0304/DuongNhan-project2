    private List<AdminProductDto> Filtered
    {
        get
        {
            var q = items.Where(p =>
                (string.IsNullOrWhiteSpace(query)
                    || p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || p.Brand.Contains(query, StringComparison.OrdinalIgnoreCase))
                && (stepFilter == 0 || p.Step == stepFilter)
                && (string.IsNullOrEmpty(skinFilter) || SkincareCatalog.SuitsSkinType(p.SkinType, skinFilter))
                && (statusFilter == "" || (statusFilter == "active") == p.IsActive)
                && (dateFrom is null || p.CreatedAt.Date >= dateFrom.Value.Date)
                && (dateTo is null || p.CreatedAt.Date <= dateTo.Value.Date));

            q = sort switch
            {
                "created-desc" => q.OrderByDescending(p => p.CreatedAt),
                "created-asc" => q.OrderBy(p => p.CreatedAt),
                "name-asc" => q.OrderBy(p => p.Name, StringComparer.CurrentCultureIgnoreCase),
                "name-desc" => q.OrderByDescending(p => p.Name, StringComparer.CurrentCultureIgnoreCase),
                "category-asc" => q.OrderBy(p => p.Category),
                "category-desc" => q.OrderByDescending(p => p.Category),
                "step-asc" => q.OrderBy(p => p.Step),
                "step-desc" => q.OrderByDescending(p => p.Step),
                "price-asc" => q.OrderBy(p => p.Price),
                "price-desc" => q.OrderByDescending(p => p.Price),
                _ => q
            };
            return q.ToList();
        }
    }

