@page "/admin/products"
@layout AdminLayout
@using System.Text
@using DuongNhan.Shared.Dtos.Admin
@inject AdminApiService Admin
@inject ProductExcelParser ExcelParser
@inject ToastService Toasts
@inject IJSRuntime JS

<PageTitle>Quản trị — Sản phẩm</PageTitle>

<div class="dn-panel" data-reveal>
    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-start mb-3">
        <div>
            <h5>Danh mục sản phẩm</h5>
            <div class="sub mb-0">@items.Count sản phẩm · gán <b>Skin Type</b> và <b>Bước routine</b> để trang gợi ý phân nhóm đúng.</div>
        </div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <button type="button" class="btn btn-dn-coral btn-sm" @onclick="BeginCreate"><i class="ph ph-plus" aria-hidden="true"></i> Thêm sản phẩm</button>
            <button type="button" class="btn btn-dn-outline btn-sm text-danger" @onclick="AskHideAll" disabled="@(busy || ScopeCount(true) == 0)"><i class="ph ph-eye-slash" aria-hidden="true"></i> @(busy ? "Đang xử lý..." : HasFilters ? $"Ẩn kết quả đang lọc ({ScopeCount(true)})" : "Ẩn toàn bộ sản phẩm")</button>
            <button type="button" class="btn btn-dn-outline btn-sm" @onclick="AskShowAll" disabled="@(busy || ScopeCount(false) == 0)"><i class="ph ph-eye" aria-hidden="true"></i> @(HasFilters ? $"Hiện kết quả đang lọc ({ScopeCount(false)})" : "Hiện toàn bộ sản phẩm")</button>
            <label class="btn btn-dn-outline btn-sm mb-0 @(importing ? "disabled" : "")">
                <i class="ph ph-upload-simple" aria-hidden="true"></i> @(importing ? "Đang import..." : "Import Excel")
                <InputFile OnChange="OnImportFileSelected" accept=".xlsx" class="d-none" disabled="@importing" />
            </label>
            <button type="button" class="btn btn-dn-outline btn-sm" @onclick="() => ExportAsync(false)" disabled="@(items.Count == 0)"><i class="ph ph-download-simple" aria-hidden="true"></i> Xuất CSV</button>
            <button type="button" class="btn btn-dn-outline btn-sm" @onclick="() => ExportAsync(true)" disabled="@(items.Count == 0)"><i class="ph ph-link" aria-hidden="true"></i> Xuất link affiliate</button>
            <a class="small" href="#" @onclick="DownloadTemplate" @onclick:preventDefault>Tải file mẫu</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(importMessage))
    {
        <div class="alert @(importFailed ? "alert-danger" : "alert-success") py-2 small">@importMessage</div>
    }

    <div class="d-flex flex-wrap gap-2 mb-3">
        <input class="form-control form-control-sm" style="width:230px" placeholder="Tìm tên hoặc thương hiệu..." @bind="query" @bind:event="oninput" aria-label="Tìm sản phẩm" />
        <select class="form-select form-select-sm" style="width:190px" @bind="stepFilter" aria-label="Lọc theo bước">
            <option value="0">Mọi bước</option>
            @foreach (var st in SkincareCatalog.Steps)
            {
                <option value="@st.Number">@st.Label</option>
            }
        </select>
        <select class="form-select form-select-sm" style="width:170px" @bind="skinFilter" aria-label="Lọc theo loại da">
            <option value="">Mọi loại da</option>
            @foreach (var t in SkincareCatalog.SkinTypes)
            {
                <option value="@t.Code">@t.Label</option>
            }
        </select>
        <select class="form-select form-select-sm" style="width:150px" @bind="statusFilter" aria-label="Lọc theo trạng thái">
            <option value="">Mọi trạng thái</option>
            <option value="active">Đang hiển thị</option>
            <option value="hidden">Đã ẩn</option>
        </select>
        <select class="form-select form-select-sm" style="width:190px" @bind="sort" aria-label="Sắp xếp">
            <option value="">Sắp xếp mặc định</option>
            <option value="created-desc">Mới nhất trước</option>
            <option value="created-asc">Cũ nhất trước</option>
            <option value="name-asc">Tên A → Z</option>
            <option value="name-desc">Tên Z → A</option>
            <option value="price-asc">Giá tăng dần</option>
            <option value="price-desc">Giá giảm dần</option>
        </select>
        <div class="d-flex align-items-center gap-1">
            <input type="date" class="form-control form-control-sm" @bind="dateFrom" aria-label="Từ ngày" title="Tạo từ ngày" />
            <span class="small text-secondary">→</span>
            <input type="date" class="form-control form-control-sm" @bind="dateTo" aria-label="Đến ngày" title="Tạo đến ngày" />
        </div>
        @if (HasFilters)
        {
            <button type="button" class="btn btn-dn-outline btn-sm" @onclick="ClearFilters"><i class="ph ph-x" aria-hidden="true"></i> Xoá bộ lọc</button>
        }
        <select class="form-select form-select-sm dn-admin-pagesize" style="width:130px" @bind="pageSize" aria-label="Số dòng mỗi trang">
            @foreach (var size in PageSizes)
            {
                <option value="@size">@size / trang</option>
            }
        </select>
    </div>

    @if (error is not null)
    {
        <div class="alert alert-warning">@error</div>
    }

    @{ 
        var filtered = Filtered;
        var totalPages = Math.Max(1, (int)Math.Ceiling(filtered.Count / (double)pageSize));
        var current = Math.Clamp(page, 1, totalPages); // e.g. after deleting the last row of the last page
        var pageRows = filtered.Skip((current - 1) * pageSize).Take(pageSize).ToList();
    
        // The editor is drawn inside the table, in place of the row being edited (or at the top for "Thêm sản phẩm"),
        // so it opens where the admin is already looking instead of in a fixed overlay.
        RenderFragment formPanel = @<div class="dn-inline-edit dn-scroll-anchor" id="admin-edit-form">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h6 class="mb-0 fw-bold">@(editingId is null ? "Thêm sản phẩm" : "Sửa sản phẩm")</h6>
                <button type="button" class="btn-close" aria-label="Đóng" @onclick="CloseForm" disabled="@saving"></button>
        
            </div>
            <div class="dn-admin-form">
                @if (formError is not null)
                {
                    <div class="alert alert-danger small" role="alert">@formError</div>
                }
                <div class="row g-3">
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="pf-name">Tên sản phẩm *</label>
                        <input class="form-control" id="pf-name" @bind="form.Name" maxlength="255" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="pf-brand">Thương hiệu</label>
                        <input class="form-control" id="pf-brand" @bind="form.Brand" maxlength="150" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="pf-cat">Danh mục</label>
                        <input class="form-control" id="pf-cat" list="pf-cats" @bind="form.Category" maxlength="100" />
                        <datalist id="pf-cats">
                            @foreach (var c in Categories)
                            {
                                <option value="@c"></option>
                            }
                        </datalist>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="pf-price">Giá (₫)</label>
                        <input class="form-control" id="pf-price" type="number" min="0" step="1000" @bind="form.Price" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold" for="pf-step">Bước routine</label>
                        <select class="form-select" id="pf-step" @bind="form.Step">
                            @foreach (var st in SkincareCatalog.Steps)
                            {
                                <option value="@st.Number">@st.Label</option>
                            }
                        </select>
                    </div>
                    <div class="col-12">
                        <span class="form-label small fw-semibold d-block mb-1">Loại da phù hợp</span>
                        <div class="d-flex flex-wrap gap-3">
                            <label class="small"><input type="checkbox" checked="@form.AllSkin" @onchange="e => form.AllSkin = (bool)(e.Value ?? false)" /> Mọi loại da</label>
                            @foreach (var t in SkincareCatalog.SkinTypes)
                            {
                                var code = t.Code;
                                <label class="small">
                                    <input type="checkbox" disabled="@form.AllSkin" checked="@form.SkinTypes.Contains(code)"
                                            @onchange="e => form.ToggleSkin(code, (bool)(e.Value ?? false))" /> @t.Label
                                </label>
                            }
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="pf-url">Link affiliate (Shopee) *</label>
                        <input class="form-control" id="pf-url" @bind="form.AffiliateUrl" maxlength="2000" placeholder="https://shopee.vn/..." />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="pf-img">Link ảnh</label>
                        <input class="form-control" id="pf-img" @bind="form.ImageUrl" maxlength="1000" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="pf-desc">Mô tả</label>
                        <textarea class="form-control" id="pf-desc" rows="2" @bind="form.Description" maxlength="2000"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="pf-cond">Tình trạng da nhắm tới (cách nhau bằng dấu phẩy)</label>
                        <input class="form-control" id="pf-cond" @bind="form.TargetConditions" maxlength="500" placeholder="Acne,EnlargedPores,Healthy" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold" for="pf-use">Cách dùng</label>
                        <textarea class="form-control" id="pf-use" rows="2" @bind="form.UsageInstructions" maxlength="1000"></textarea>
                    </div>
                    <div class="col-12"><label class="small"><input type="checkbox" @bind="form.IsActive" /> Hiển thị trên website</label></div>
                </div>
                <div class="d-flex justify-content-end gap-2 mt-4">
                    <button type="button" class="btn btn-dn-outline" @onclick="CloseForm" disabled="@saving">Huỷ</button>
                    <button type="button" class="btn btn-dn-coral" @onclick="SaveAsync" disabled="@saving">@(saving ? "Đang lưu..." : "Lưu")</button>
                </div>
            </div>
        </div>;
    }

    @if (selected.Count > 0)
    {
        <div class="alert alert-info py-2 small d-flex flex-wrap align-items-center gap-2" role="status">
            <b>@selected.Count</b> sản phẩm đã chọn
            <button type="button" class="btn btn-sm btn-dn-outline" @onclick="SelectAllFiltered">Chọn tất cả @filtered.Count kết quả</button>
            <button type="button" class="btn btn-sm btn-dn-outline" disabled="@busy" @onclick="() => SetActiveAsync(SelectedItems, false)"><i class="ph ph-eye-slash" aria-hidden="true"></i> Ẩn</button>
            <button type="button" class="btn btn-sm btn-dn-outline" disabled="@busy" @onclick="() => SetActiveAsync(SelectedItems, true)"><i class="ph ph-eye" aria-hidden="true"></i> Hiện</button>
            <button type="button" class="btn btn-sm btn-dn-outline text-danger" disabled="@busy" @onclick="AskDeleteSelected"><i class="ph ph-trash" aria-hidden="true"></i> Xoá</button>
            <button type="button" class="btn btn-sm btn-link" @onclick="() => selected.Clear()">Bỏ chọn</button>
        </div>
    }

    @if (undo is not null)
    {
        <div class="alert alert-secondary py-2 small d-flex align-items-center gap-2" role="status">
            @undo.Label
            <button type="button" class="btn btn-sm btn-dn-outline" disabled="@busy" @onclick="UndoAsync"><i class="ph ph-arrow-counter-clockwise" aria-hidden="true"></i> Hoàn tác</button>
        </div>
    }

    <div class="dn-table-wrap dn-scroll-anchor" id="admin-products-top">
        <table class="dn-table">
            <thead>
                <tr>
                    <th style="width:32px"><input type="checkbox" aria-label="Chọn tất cả trang này" checked="@(pageRows.Count > 0 && pageRows.All(r => selected.Contains(r.Id)))" @onchange="e => TogglePage(pageRows, (bool)(e.Value ?? false))" /></th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" @onclick='() => ToggleSort("name")'>Sản phẩm@(SortIcon("name"))</button></th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" @onclick='() => ToggleSort("category")'>Danh mục@(SortIcon("category"))</button></th>
                    <th>Skin Type</th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" @onclick='() => ToggleSort("step")'>Step@(SortIcon("step"))</button></th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" @onclick='() => ToggleSort("price")'>Giá@(SortIcon("price"))</button></th>
                    <th><button type="button" class="btn btn-link p-0 text-decoration-none fw-bold" @onclick='() => ToggleSort("created")'>Ngày tạo@(SortIcon("created"))</button></th>
                    <th>Hiển thị</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (formOpen && editingId is null)
                {
                    <tr class="dn-edit-row"><td colspan="9">@formPanel</td></tr>
                }
                @if (loading)
                {
                    <tr><td colspan="9" class="text-center py-4"><div class="spinner-border spinner-border-sm text-success"></div></td></tr>
                }
                else if (filtered.Count == 0)
                {
                    <tr><td colspan="9" class="text-center text-secondary py-4">Không có sản phẩm phù hợp.</td></tr>
                }
                else
                {
                    @foreach (var p in pageRows)
                    {
                        if (formOpen && editingId == p.Id)
                        {
                            <tr class="dn-edit-row" @key="p.Id">
                                <td colspan="9">
                                    @formPanel
                                </td>
                            </tr>
                            continue;
                        }

                        <tr @key="p.Id" class="@(selected.Contains(p.Id) ? "table-active" : "")">
                            <td><input type="checkbox" aria-label="Chọn @p.Name" checked="@selected.Contains(p.Id)" @onchange="e => ToggleSelect(p.Id, (bool)(e.Value ?? false))" /></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrWhiteSpace(p.ImageUrl))
                                    {
                                        <img class="dn-admin-thumb" src="@p.ImageUrl" alt="" loading="lazy" onerror="this.style.display='none'" />
                                    }
                                    <div><div class="fw-semibold">@p.Name</div><small class="text-secondary">@p.Brand</small></div>
                                </div>
                            </td>
                            <td>@p.Category</td>
                            <td>
                                @foreach (var code in p.SkinType.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="dn-pill me-1">@SkincareCatalog.SkinTypeLabel(code)</span>
                                }
                            </td>
                            <td>
                                @if (SkincareCatalog.GetStep(p.Step) is { } info)
                                {
                                    <span class="dn-stepcell"><i class="ph @info.Icon" aria-hidden="true"></i> @info.Label</span>
                                }
                                else
                                {
                                    <span class="text-secondary">—</span>
                                }
                            </td>
                            <td>@FormatPrice(p.Price)</td>
                            <td class="text-nowrap">@p.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td><span class="dn-pill @(p.IsActive ? "ok" : "off")">@(p.IsActive ? "Đang hiển thị" : "Đã ẩn")</span></td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-dn-outline" @onclick="() => BeginEdit(p)">Sửa</button>
                                <button class="btn btn-sm btn-dn-outline" @onclick="() => ToggleActiveAsync(p)">@(p.IsActive ? "Ẩn" : "Hiện")</button>
                                <button class="btn btn-sm btn-dn-outline text-danger" @onclick="() => DeleteAsync(p)" aria-label="Xoá @p.Name"><i class="ph ph-trash" aria-hidden="true"></i></button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

    @if (!loading)
    {
        <Pagination Page="current" TotalPages="totalPages" TotalItems="filtered.Count" PageSize="pageSize" PageChanged="GoToPageAsync" />
    }
</div>

@if (confirm is not null)
{
    <div class="modal-backdrop fade show"></div>
    <div class="modal fade show d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="confirm-title" @onclick="CancelConfirm">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirm-title">@confirm.Title</h5>
                    <button type="button" class="btn-close" aria-label="Đóng" @onclick="CancelConfirm"></button>
                </div>
                <div class="modal-body">
                    <p class="mb-2">@confirm.Message</p>
                    @if (confirm.RequireText is not null)
                    {
                        <label class="form-label small" for="confirm-input">Gõ <b>@confirm.RequireText</b> để xác nhận:</label>
                        <input id="confirm-input" class="form-control" @bind="confirmInput" @bind:event="oninput" autocomplete="off" />
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-dn-outline" @onclick="CancelConfirm">Huỷ</button>
                    <button type="button" class="btn @(confirm.Danger ? "btn-danger" : "btn-dn-coral")" disabled="@(!ConfirmReady)" @onclick="RunConfirmAsync">@confirm.ConfirmLabel</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const long MaxImportBytes = 5 * 1024 * 1024;

    private static readonly string[] Categories =
        ["MakeupRemover", "Cleanser", "Toner", "Exfoliant", "Serum", "Essence", "Moisturizer", "Sunscreen", "Treatment", "Mask"];

    private sealed class ProductForm
    {
        public string Name { get; set; } = "";
        public string Brand { get; set; } = "";
        public string Category { get; set; } = "";
        public decimal Price { get; set; }
        public int Step { get; set; } = 2;
        public bool AllSkin { get; set; } = true;
        public HashSet<string> SkinTypes { get; } = new(StringComparer.OrdinalIgnoreCase);
        public string AffiliateUrl { get; set; } = "";
        public string ImageUrl { get; set; } = "";
        public string Description { get; set; } = "";
        public string TargetConditions { get; set; } = "";
        public string UsageInstructions { get; set; } = "";
        public bool IsActive { get; set; } = true;

        public void ToggleSkin(string code, bool on)
        {
            if (on) SkinTypes.Add(code); else SkinTypes.Remove(code);
        }

        public string SkinTypeValue => AllSkin || SkinTypes.Count == 0
            ? SkincareCatalog.AllSkinTypes
            : string.Join(',', SkinTypes);
    }

    private List<AdminProductDto> items = [];
    private bool loading = true;
    private string? error;
    private static readonly int[] PageSizes = [10, 20, 50, 100];

    private int page = 1;
    private int pageSizeValue = 20;
    private string queryValue = "";
    private int stepFilterValue;
    private string skinFilterValue = "";
    private string statusFilterValue = "";
    private string sortValue = "";
    private DateTime? dateFromValue;
    private DateTime? dateToValue;
    private bool busy;
    private bool prefsLoaded;
    private const string PrefsKey = "dn-admin-products-prefs";

    private string statusFilter { get => statusFilterValue; set { statusFilterValue = value; ResetPaging(); } }
    private string sort { get => sortValue; set { sortValue = value; ResetPaging(); } }
    private DateTime? dateFrom { get => dateFromValue; set { dateFromValue = value; ResetPaging(); } }
    private DateTime? dateTo { get => dateToValue; set { dateToValue = value; ResetPaging(); } }

    private readonly HashSet<Guid> selected = [];
    private sealed record UndoInfo(List<Guid> Ids, bool Restore, string Label);
    private UndoInfo? undo;
    private int undoVersion;

    private sealed class ConfirmState
    {
        public string Title { get; init; } = "";
        public string Message { get; init; } = "";
        public string ConfirmLabel { get; init; } = "Xác nhận";
        public bool Danger { get; init; }
        public string? RequireText { get; init; }
        public Func<Task> Action { get; init; } = () => Task.CompletedTask;
    }
    private ConfirmState? confirm;
    private string confirmInput = "";
    private bool ConfirmReady => confirm is not null
        && (confirm.RequireText is null || string.Equals(confirmInput.Trim(), confirm.RequireText, StringComparison.CurrentCultureIgnoreCase));

    private sealed record Prefs(string Query, int Step, string Skin, string Status, string Sort, DateTime? From, DateTime? To, int PageSize);

    // Changing a filter or the page size returns to page 1 and closes the editor (its row may no longer be on screen)
    private string query { get => queryValue; set { queryValue = value; ResetPaging(); } }
    private int stepFilter { get => stepFilterValue; set { stepFilterValue = value; ResetPaging(); } }
    private string skinFilter { get => skinFilterValue; set { skinFilterValue = value; ResetPaging(); } }
    private int pageSize { get => pageSizeValue; set { pageSizeValue = value; ResetPaging(); } }

    private void ResetPaging()
    {
        page = 1;
        formOpen = false;
        selected.Clear(); // a selection must never silently include rows the filter has hidden
        _ = SavePrefsAsync();
    }

    private async Task SavePrefsAsync()
    {
        if (!prefsLoaded) return;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(
                new Prefs(queryValue, stepFilterValue, skinFilterValue, statusFilterValue, sortValue, dateFromValue, dateToValue, pageSizeValue));
            await JS.InvokeVoidAsync("localStorage.setItem", PrefsKey, json);
        }
        catch { /* persistence is a nicety */ }
    }

    private async Task RestorePrefsAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", PrefsKey);
            if (!string.IsNullOrWhiteSpace(json) && System.Text.Json.JsonSerializer.Deserialize<Prefs>(json) is { } p)
            {
                queryValue = p.Query ?? "";
                stepFilterValue = p.Step;
                skinFilterValue = p.Skin ?? "";
                statusFilterValue = p.Status ?? "";
                sortValue = p.Sort ?? "";
                dateFromValue = p.From;
                dateToValue = p.To;
                if (PageSizes.Contains(p.PageSize)) pageSizeValue = p.PageSize;
            }
        }
        catch { /* ignore corrupt or unavailable storage */ }
        prefsLoaded = true;
        StateHasChanged();
    }

    private bool HasFilters => !string.IsNullOrWhiteSpace(queryValue) || stepFilterValue != 0 || skinFilterValue != ""
        || statusFilterValue != "" || dateFromValue is not null || dateToValue is not null;

    private void ClearFilters()
    {
        queryValue = ""; stepFilterValue = 0; skinFilterValue = ""; statusFilterValue = "";
        dateFromValue = null; dateToValue = null;
        ResetPaging();
    }

    private string SortIcon(string col)
        => sortValue == col + "-asc" ? " ▲" : sortValue == col + "-desc" ? " ▼" : "";

    private void ToggleSort(string col)
    {
        var defaultDir = col == "created" ? "desc" : "asc";
        sort = sortValue == col + "-" + defaultDir ? col + (defaultDir == "asc" ? "-desc" : "-asc") : col + "-" + defaultDir;
    }

    // ── selection ───────────────────────────────────────────

    private List<AdminProductDto> SelectedItems => items.Where(p => selected.Contains(p.Id)).ToList();

    private void ToggleSelect(Guid id, bool on) { if (on) selected.Add(id); else selected.Remove(id); }

    private void TogglePage(List<AdminProductDto> rows, bool on)
    {
        foreach (var r in rows) ToggleSelect(r.Id, on);
    }

    private void SelectAllFiltered()
