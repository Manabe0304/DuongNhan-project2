    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        importMessage = null;
        importFailed = false;
        importing = true;

        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                Fail("Chỉ hỗ trợ file .xlsx.");
                return;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxImportBytes))
                await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var parsed = ExcelParser.Parse(buffer);
            if (parsed.Rows.Count == 0)
            {
                Fail(string.Join(" ", parsed.Errors.Take(5)));
                return;
            }

            var result = await Admin.ImportProductsAsync(parsed.Rows);
            await LoadAsync();

            var skipped = parsed.Errors.Count + result.Skipped;
            importMessage = $"Import thành công: {result.Created} sản phẩm mới, {result.Updated} cập nhật."
                + (skipped > 0 ? $" Bỏ qua {skipped} dòng lỗi. {string.Join(" ", parsed.Errors.Take(3))}" : "");
        }
        catch (Exception ex) { Fail($"Import thất bại: {ex.Message}"); }
        finally { importing = false; }
    }

    private void Fail(string message) { importFailed = true; importMessage = message; }

    private async Task DownloadTemplate()
        => await DownloadAsync("products-import-template.xlsx", ExcelParser.BuildTemplate());

    private async Task ExportAsync(bool affiliateOnly)
    {
        // Export follows the current filters (and sort), so "export what I see" works.
        var source = Filtered;
        var rows = affiliateOnly ? source.Where(p => !string.IsNullOrWhiteSpace(p.AffiliateUrl)).ToList() : source;

        var csv = new StringBuilder("STT,Tên sản phẩm,Thương hiệu,Danh mục,Loại da,Bước routine,Giá,Link affiliate,Trạng thái,Ngày tạo\n");
        var n = 1;
        foreach (var p in rows)
        {
            var skin = string.Join(" / ", p.SkinType.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(SkincareCatalog.SkinTypeLabel));
            csv.Append(n++).Append(',')
               .Append(Cell(p.Name)).Append(',')
               .Append(Cell(p.Brand)).Append(',')
               .Append(Cell(p.Category)).Append(',')
               .Append(Cell(skin)).Append(',')
               .Append(Cell(SkincareCatalog.GetStep(p.Step)?.Label ?? "")).Append(',')
               .Append(p.Price.ToString("0", System.Globalization.CultureInfo.InvariantCulture)).Append(',')
               .Append(Cell(p.AffiliateUrl ?? "")).Append(',')
               .Append(Cell(p.IsActive ? "Hoạt động" : "Ẩn")).Append(',')
               .Append(p.CreatedAt.ToString("yyyy-MM-dd")).Append('\n');
        }

        // UTF-8 BOM so Excel shows Vietnamese text correctly.
        var bytes = new UTF8Encoding(true).GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        var name = affiliateOnly ? "affiliate-links" : "products";
        await DownloadAsync($"{name}-{DateTime.Now:yyyyMMdd}.csv", bytes);
    }

    /// <summary>Quotes a CSV cell and neutralises spreadsheet formulas (=, +, -, @).</summary>
    private static string Cell(string value)
    {
        if (value.Length > 0 && "=+-@".Contains(value[0])) value = "'" + value;
        return "\"" + value.Replace("\"", "\"\"") + "\"";
    }

    private async Task DownloadAsync(string fileName, byte[] bytes)
    {
        using var stream = new DotNetStreamReference(new MemoryStream(bytes));
        await JS.InvokeVoidAsync("dnDownloadFile", fileName, stream);
    }
