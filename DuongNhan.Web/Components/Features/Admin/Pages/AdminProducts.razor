    }

    private void DeleteAsync(AdminProductDto p)
    {
        confirm = new ConfirmState
        {
            Title = "Xoá sản phẩm",
            Message = $"Xoá sản phẩm “{p.Name}”? Sản phẩm sẽ biến mất khỏi website.",
            ConfirmLabel = "Xoá",
            Danger = true,
            Action = async () =>
            {
