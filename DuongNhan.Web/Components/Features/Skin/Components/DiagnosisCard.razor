@* Primary result panel for a single skin diagnosis. *@
<div class="dn-card p-4 p-lg-5">
    <div class="d-flex justify-content-between align-items-start gap-3">
        <div>
            <span class="badge rounded-pill text-bg-secondary">@(Diagnosis.Severity ?? "—")</span>
            <h2 class="mt-3 mb-1">@Diagnosis.PrimaryCondition</h2>
            <p class="text-secondary small mb-0">@(Diagnosis.Summary ?? "Kết quả phân tích đã được tạo.")</p>
        </div>
        <div class="dn-confidence">
            <strong>@Percentage%</strong>
            <small>Confidence</small>
        </div>
    </div>

    <hr />

    <div class="row g-3">
        <div class="col-6 col-md-3">
            <div class="mini-stat"><small>Loại da</small><strong>@(Diagnosis.SkinType ?? "—")</strong></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="mini-stat"><small>Điểm da</small><strong>@(Diagnosis.SkinHealthScore?.ToString() ?? "—")</strong></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="mini-stat"><small>Số tình trạng</small><strong>@(Diagnosis.Conditions?.Count ?? 0)</strong></div>
        </div>
        <div class="col-6 col-md-3">
            <div class="mini-stat"><small>Thời điểm</small><strong>@Diagnosis.DiagnosedAt.ToLocalTime().ToString("dd/MM/yyyy")</strong></div>
        </div>
    </div>

    <h6 class="mt-4 mb-2">Phân tích chi tiết</h6>
    <DiagnosisConditionList Conditions="Diagnosis.Conditions" />
</div>

@code {
    [Parameter, EditorRequired] public DiagnosisDto Diagnosis { get; set; } = default!;

    private int Percentage => Diagnosis.Confidence <= 1
        ? (int)Math.Round(Diagnosis.Confidence * 100)
        : (int)Math.Round(Diagnosis.Confidence);
}