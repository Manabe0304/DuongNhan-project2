@* One past scan: thumbnail, date, skin type, main finding and score. Links through to the full diagnosis. *@
<a class="dn-hist-item" href="/diagnosis/@Item.SkinImageId">
    <div class="dn-hist-thumb">
        <img src="/skin-image/@Item.SkinImageId" alt="" loading="lazy" onerror="this.style.display='none'" />
        <i class="ph ph-user-focus" aria-hidden="true"></i>
    </div>

    <div class="dn-hist-main">
        <div class="dn-hist-meta">
            <span><i class="ph ph-calendar-blank" aria-hidden="true"></i> @Item.DiagnosedAt.ToVn().ToString("dd/MM/yyyy")</span>
            <span class="dn-dot-sep" aria-hidden="true">•</span>
            <span><i class="ph ph-clock" aria-hidden="true"></i> @Item.DiagnosedAt.ToVn().ToString("HH:mm")</span>
            @if (!string.IsNullOrWhiteSpace(Item.SkinType))
            {
                <span class="dn-dot-sep" aria-hidden="true">•</span>
                <span><i class="ph ph-stack" aria-hidden="true"></i> @Item.SkinType</span>
            }
        </div>
        <h3>@Item.PrimaryCondition</h3>
        <p>@(Item.Summary ?? "Không có mô tả.")</p>
    </div>

    <div class="dn-hist-side">
        @if (Item.SkinHealthScore is { } score)
        {
            <div class="dn-score @(score >= 80 ? "good" : score >= 65 ? "mid" : "low")"><small>Điểm da</small><b>@score</b><span>/100</span></div>
        }
        <span class="dn-hist-go" aria-hidden="true"><i class="ph ph-arrow-right"></i></span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public DiagnosisDto Item { get; set; } = default!;
}
