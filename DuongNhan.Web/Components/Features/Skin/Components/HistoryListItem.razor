@* Compact history entry that links through to the full diagnosis. *@
<a class="dn-card p-4 d-block h-100 text-decoration-none" href="/diagnosis/@Item.Id">
    <div class="d-flex justify-content-between align-items-start gap-2">
        <span class="badge rounded-pill text-bg-secondary">@(Item.Severity ?? "—")</span>
        <small class="text-secondary">@Item.DiagnosedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</small>
    </div>

    <h5 class="mt-3 mb-2">@Item.PrimaryCondition</h5>
    <p class="small text-secondary line-clamp-3 mb-3">@(Item.Summary ?? "Không có mô tả.")</p>

    <div class="d-flex justify-content-between align-items-center">
        <ConfidenceBadge Value="@Item.Confidence" />
        <span class="small dn-cta-inline">Xem kết quả<i class="ph ph-arrow-right" aria-hidden="true"></i></span>
    </div>
</a>

@code {
    [Parameter, EditorRequired] public DiagnosisDto Item { get; set; } = default!;
}