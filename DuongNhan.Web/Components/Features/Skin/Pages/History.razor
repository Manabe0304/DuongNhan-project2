@page "/history"
@inject DuongNhanApiService Api

<PageTitle>Lịch sử phân tích — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <section class="dn-pagehead" data-reveal>
        <div>
            <span class="dn-kicker">Nhật ký chăm sóc da</span>
            <h1>Lịch sử phân tích</h1>
            <p>Theo dõi tiến trình của làn da qua từng lần scan và xem lại kết quả bất cứ lúc nào.</p>
        </div>
        <a href="/scan" class="btn btn-dn-coral dn-btn"><i class="ph ph-sparkle" aria-hidden="true"></i> Thực hiện lần quét mới</a>
    </section>

    @if (loading)
    {
        <div class="dn-card p-5 text-center">
            <div class="spinner-border text-success" role="status"></div>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="dn-empty" data-reveal>
            <i class="ph ph-clock-counter-clockwise dn-empty-icon" aria-hidden="true"></i>
            <h5>Chưa có dữ liệu chẩn đoán nào</h5>
            <p>Bạn chưa thực hiện lần quét nào. Hãy chụp hoặc tải ảnh để nhận kết quả phân tích đầu tiên.</p>
            <a href="/scan" class="btn btn-dn-coral">Quét da ngay bây giờ</a>
        </div>
    }
    else
    {
        <p class="dn-count">@items.Count lần phân tích gần nhất</p>
        <div class="dn-hist-list">
            @for (var i = 0; i < items.Count; i++)
            {
                var item = items[i];
                <div data-reveal style="--dn-delay:@(Math.Min(i, 5) * 60)ms">
                    <HistoryListItem Item="item" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DiagnosisDto> items = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Api.GetHistoryTypedAsync();
        }
        catch
        {
            items = [];
        }

        loading = false;
    }
}
