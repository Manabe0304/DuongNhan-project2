@page "/history"
@inject DuongNhanApiService Api

<div class="container dn-container dn-page">
    <div class="dn-page-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div>
            <span class="dn-kicker">Your Progress</span>
            <h1>Lịch sử phân tích</h1>
            <p>Theo dõi những lần scan trước và xem lại kết quả bất cứ lúc nào.</p>
        </div>
        <a href="/scan" class="btn btn-dn-coral">Scan da ngay</a>
    </div>

    @if (loading)
    {
        <div class="dn-card p-5 text-center">
            <div class="spinner-border text-success"></div>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="dn-empty">
            <h5>Chưa có lịch sử</h5>
            <p>Hãy thực hiện lần phân tích đầu tiên để bắt đầu theo dõi tiến triển của làn da.</p>
            <a href="/scan" class="btn btn-dn-coral">Scan da ngay</a>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var item in items)
            {
                <div class="col-md-6 col-xl-4">
                    <HistoryListItem Item="item" />
                </div>
            }
        </div>
    }
</div>

@code {
    private List<DiagnosisDto> items = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = await Api.GetHistoryTypedAsync();
        }
        catch
        {
            items = [];
        }

        loading = false;
    }
}