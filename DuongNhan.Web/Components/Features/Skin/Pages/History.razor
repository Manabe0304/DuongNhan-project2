@page "/history"
@inject DuongNhanApiService Api

<div class="container dn-container dn-page">
    <div class="dn-page-heading"><span class="dn-kicker">Your Progress</span><h1>Lịch sử phân tích</h1><p>Theo dõi những lần scan trước và xem lại kết quả bất cứ lúc nào.</p></div>
    @if (loading) { <div class="dn-card p-5 text-center"><div class="spinner-border text-success"></div></div> }
    else if (items.Count == 0) { <div class="dn-empty"><h5>Chưa có lịch sử</h5><p>Hãy thực hiện lần phân tích đầu tiên để bắt đầu theo dõi tiến triển.</p><a href="/scan" class="btn btn-dn-coral">Scan da ngay</a></div> }
    else
    {
        <div class="row g-3">
            @foreach (var item in items)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="dn-card p-4 h-100">
                        <div class="d-flex justify-content-between"><span class="badge bg-success-subtle text-success">@Text(item, "severity", "—")</span><small class="text-secondary">@Text(item, "diagnosedAt", "—")</small></div>
                        <h5 class="mt-3">@Text(item, "primaryCondition", "Skin analysis")</h5>
                        <p class="small text-secondary line-clamp-3">@Text(item, "summary", "Không có mô tả.")</p>
                        <a href="@Route(item)" class="btn btn-sm btn-dn-outline">Xem kết quả</a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<System.Text.Json.JsonElement> items = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        try { items = await Api.GetHistoryAsync(); } catch { items = []; }
        loading = false;
    }

    private static string Text(System.Text.Json.JsonElement item, string name, string fallback)
    {
        foreach (var key in new[] { name, char.ToUpperInvariant(name[0]) + name[1..] })
            if (item.TryGetProperty(key, out var p))
                return p.ValueKind == System.Text.Json.JsonValueKind.String ? p.GetString() ?? fallback : p.ToString();
        return fallback;
    }

    private static string Route(System.Text.Json.JsonElement item)
    {
        var raw = Text(item, "id", "");
        return Guid.TryParse(raw, out var id) ? $"/diagnosis/{id}" : "/history";
    }
}
