@page "/scan"
@page "/upload"
@inject DuongNhanApiService Api
@inject ImageValidationService ImageValidation
@inject NavigationService Navigation
@inject IJSRuntime JS
@inject AnalyticsService Analytics
@inject UsageState Usage
@inject UiSessionService Session

<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">AI Skin Analysis</span>
        <h1>Phân tích làn da</h1>
        <p>Chụp hoặc tải ảnh khuôn mặt rõ nét. Ảnh sẽ được kiểm tra chất lượng trước khi gửi đi phân tích.</p>
    </div>

    @if (OutOfScans)
    {
        <div class="alert alert-danger d-flex flex-wrap align-items-center justify-content-between gap-2" role="alert">
            <span><i class="ph ph-warning-circle" aria-hidden="true"></i> Bạn đã dùng hết @Usage.Current!.ScansLimit lượt quét của gói @Usage.Current.PlanName trong tháng này. Lượt quét sẽ được làm mới vào đầu tháng sau.</span>
            <a href="/pricing" class="btn btn-dn-outline btn-sm dn-btn">Xem bảng giá gói</a>
        </div>
    }
    else if (LowOnScans)
    {
        <div class="alert alert-warning small" role="alert">Bạn chỉ còn @Usage.Current!.ScansRemaining lượt quét trong tháng này.</div>
    }

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="dn-card p-4 p-lg-5">

                @if (image is null)
                {
                    <CaptureModeSelector Mode="mode" ModeChanged="OnModeChanged" />

                    <div class="mt-4">
                        @if (mode == CaptureMode.Camera)
                        {
                            <CameraCapture OnCaptured="OnCapturedAsync" />
                        }
                        else
                        {
                            <SkinUploadForm OnImageSelected="OnImageSelectedAsync" OnError="OnUploadError" />
                        }
                    </div>
                }
                else if (cropping)
                {
                    <ImageCropper Source="@image.ToDataUrl()"
                                  OnCropped="OnCroppedAsync"
                                  OnCancel="() => cropping = false" />
                }
                else
                {
                    <SkinImagePreview Source="@image.ToDataUrl()"
                                      Caption="@image.FileName"
                                      Alt="Ảnh da sẽ phân tích" />

                    <div class="mt-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h6 class="mb-0">Chất lượng ảnh</h6>
                            @if (quality is not null)
                            {
                                <span class="dn-quality-score">@quality.Score/100</span>
                            }
                        </div>
                        <ImageQualityCheck Report="quality" />
                    </div>

                    @if (quality is { IsAcceptable: false })
                    {
                        <div class="alert alert-warning small mt-3 mb-0">
                            Ảnh chưa đạt yêu cầu. Bạn vẫn có thể tiếp tục, nhưng kết quả có thể kém chính xác hơn.
                        </div>
                    }

                    <div class="d-flex flex-wrap gap-2 mt-4">
                        <button class="btn btn-dn-coral btn-lg flex-grow-1 dn-btn"
                                @onclick="AnalyzeAsync"
                                disabled="@(loading || OutOfScans)">
                            <i class="ph ph-scan" aria-hidden="true"></i>@(loading ? "Đang phân tích..." : "Phân tích bằng AI")
                        </button>
                        <button class="btn btn-dn-outline dn-btn" @onclick="() => cropping = true" disabled="@loading">
                            <i class="ph ph-crop" aria-hidden="true"></i>Cắt vuông
                        </button>
                        <button class="btn btn-dn-outline dn-btn" @onclick="Reset" disabled="@loading">
                            <i class="ph ph-arrows-clockwise" aria-hidden="true"></i>Chọn ảnh khác
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="alert @(success ? "alert-success" : "alert-danger") small mt-3 mb-0">@message</div>
                }
            </div>
        </div>

        <div class="col-lg-5">
            <div class="dn-card p-4 h-100">
                <span class="dn-kicker">Chụp ảnh đúng cách</span>
                <h5 class="mt-2">Để AI phân tích chính xác</h5>

                <ul class="small text-secondary dn-bullet-list">
                    <li><strong>Ánh sáng:</strong> ánh sáng trắng, đều (gần cửa sổ). Tránh đèn chiếu thẳng gây lóa.</li>
                    <li><strong>Khoảng cách:</strong> khoảng 20 cm, khuôn mặt chiếm phần lớn khung hình.</li>
                    <li><strong>Góc chụp:</strong> chụp thẳng, thêm một góc nghiêng nhẹ để tránh vùng bóng.</li>
                    <li><strong>Chuẩn bị:</strong> tẩy trang, không dùng filter hay beauty mode.</li>
                    <li><strong>Độ phân giải:</strong> nên đạt tối thiểu 1024px ở cạnh ngắn để thấy rõ lỗ chân lông.</li>
                </ul>

                <div class="dn-mini-banner mt-4">
                    <strong>Ảnh chỉ dùng để phân tích.</strong><br />
                    Kết quả mang tính sàng lọc, không thay thế chẩn đoán y khoa.
                </div>

                <div class="mt-3 d-flex flex-column gap-2">
                    <a href="/history" class="dn-link">Xem lịch sử phân tích<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                    @* <a href="/doctors" class="dn-link">Cần tư vấn chuyên sâu? Kết nối bác sĩ<i class="ph ph-arrow-right" aria-hidden="true"></i></a> *@
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private CaptureMode mode = CaptureMode.Camera;
    private SkinImageInput? image;
    private ImageQualityReport? quality;
    private bool cropping;
    private bool loading;
    private bool success;
    private string? message;

    private const string QuotaMessage = "Bạn đã hết lượt quét trong tháng này.";

    // Admin accounts report an unlimited allowance, so they never hit either state.
    private bool OutOfScans => Usage.Current is { IsUnlimited: false, ScansLimit: > 0, ScansRemaining: <= 0 };
    private bool LowOnScans => Usage.Current is { IsUnlimited: false, ScansLimit: > 0, ScansRemaining: > 0 and <= 3 };

    private Task OnModeChanged(CaptureMode value)
    {
        mode = value;
        message = null;
        return Task.CompletedTask;
    }

    private async Task OnCapturedAsync(string dataUrl)
    {
        var input = SkinImageInput.FromDataUrl(dataUrl);
        if (input is null)
        {
            message = "Không xử lý được ảnh vừa chụp. Vui lòng thử lại.";
            return;
        }

        await SetImageAsync(input);
    }

    private Task OnImageSelectedAsync(SkinImageInput input) => SetImageAsync(input);

    private Task OnUploadError(string? error)
    {
        message = error;
        return Task.CompletedTask;
    }

    private async Task OnCroppedAsync(string dataUrl)
    {
        var input = SkinImageInput.FromDataUrl(dataUrl);
        if (input is null) return;

        cropping = false;
        await SetImageAsync(input);
    }

    private async Task SetImageAsync(SkinImageInput input)
    {
        message = null;
        quality = null;
        cropping = false;

        var validation = await ImageValidation.ValidateAsync(input);
        if (!validation.IsValid)
        {
            image = null;
            message = validation.Message;
            return;
        }

        image = input;
        quality = await ImageValidation.AssessAsync(input.ToDataUrl());
    }

    private void Reset()
    {
        image = null;
        quality = null;
        cropping = false;
        success = false;
        message = null;
    }

    private async Task AnalyzeAsync()
    {
        // `loading` is checked and set before the first await, so a double click cannot start two scans.
        if (image is null || loading) return;

        if (OutOfScans)
        {
            success = false;
            message = QuotaMessage;
            return;
        }

        // The token lives in localStorage, which every tab of this browser shares. If another tab signed in as a
        // different account, this tab would still show the old name but send the new account's token.
        loading = true;
        success = false;
        message = null;

        try
        {
            var tokenEmail = await Api.GetTokenEmailAsync();
            if (!string.IsNullOrWhiteSpace(Session.Email) && !string.IsNullOrWhiteSpace(tokenEmail)
                && !string.Equals(Session.Email, tokenEmail, StringComparison.OrdinalIgnoreCase))
            {
                message = $"Trình duyệt đang đăng nhập bằng tài khoản khác ({tokenEmail}) ở tab khác. Hãy tải lại trang hoặc đăng nhập lại.";
                return;
            }

            await Analytics.EventAsync("skin_scan_start", new { source = mode.ToString().ToLowerInvariant() });

            var upload = await DownscaleAsync(image);

            var uploaded = await Api.UploadImageAsync(upload);
            await Api.DiagnoseTypedAsync(uploaded.SkinImageId);

            success = true;
            message = "Phân tích da thành công.";
            await Analytics.EventAsync("skin_scan_complete", new { source = mode.ToString().ToLowerInvariant() });
            await Usage.RefreshAsync(); // top-bar scan counter
            Navigation.NavigateTo($"/diagnosis/{uploaded.SkinImageId}");
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            message = "Phiên đăng nhập đã hết hạn. Hãy đăng nhập lại rồi quét lại.";
        }
        catch (Refit.ApiException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            // The API refused the scan because the monthly allowance is used up.
            message = QuotaMessage;
            await Usage.RefreshAsync();
        }
        catch (Exception ex)
        {
            message = $"Không thể phân tích ảnh: {ex.Message}";
            await Analytics.EventAsync("skin_scan_error", new { error_type = "api_error" });
        }
        finally
        {
            loading = false;
        }
    }

    // Keeps uploads small: a 2048px long edge is more than enough for the model.
    private const int DownscaleThresholdBytes = 1_500_000;

    private async Task<SkinImageInput> DownscaleAsync(SkinImageInput source)
    {
        // Small images gain nothing from a browser round trip (server -> browser -> server over SignalR).
        if (source.Bytes.Length <= DownscaleThresholdBytes) return source;

        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            var module = await JS.InvokeAsync<IJSObjectReference>("import", cts.Token, "./js/camera.js");
            var downscaled = await module.InvokeAsync<string>("downscale", cts.Token, source.ToDataUrl(), 2048);
            await module.DisposeAsync();

            return SkinImageInput.FromDataUrl(downscaled) ?? source;
        }
        catch
        {
            return source;
        }
    }
}
