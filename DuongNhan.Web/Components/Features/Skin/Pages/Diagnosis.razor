@page "/diagnosis/{Id:guid}"
@inject DuongNhanApiService Api

<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">AI Result</span>
        <h1>Kết quả phân tích</h1>
        <p>Kết quả từ lần phân tích da của bạn, kèm các tình trạng được ghi nhận.</p>
    </div>

    @if (loading)
    {
        <div class="dn-card p-5 text-center">
            <div class="spinner-border text-success"></div>
            <p class="small text-secondary mt-3 mb-0">Đang tải kết quả...</p>
        </div>
    }
    else if (diagnosis is null)
    {
        <div class="alert alert-warning">
            Không tìm thấy kết quả cho lần phân tích này. <a href="/scan">Phân tích ảnh mới</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            <div class="col-lg-8">
                <DiagnosisCard Diagnosis="diagnosis!" />
            </div>

            <div class="col-lg-4">
                <div class="dn-card p-4">
                    <h5>Bước tiếp theo</h5>
                    <p class="small text-secondary">
                        Dùng kết quả như một công cụ hỗ trợ. Hãy tham khảo bác sĩ da liễu nếu triệu chứng
                        kéo dài hoặc nặng lên.
                    </p>

                    <a class="btn btn-dn-coral w-100" href="/recommendations">Xem sản phẩm phù hợp</a>
                    <a class="btn btn-dn-outline w-100 mt-2" href="/scan">Phân tích ảnh mới</a>
                    <a class="btn btn-dn-outline w-100 mt-2" href="/history">Lịch sử phân tích</a>
                    <a class="btn btn-dn-outline w-100 mt-2" href="/doctors">Đặt lịch với bác sĩ</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    private DiagnosisDto? diagnosis;
    private bool loading = true;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;

        try
        {
            diagnosis = await Api.DiagnoseTypedAsync(Id);
        }
        catch
        {
            diagnosis = null;
        }

        loading = false;
    }
}