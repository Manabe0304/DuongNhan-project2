@page "/"
@inject UiSessionService Session
@implements IDisposable
@inject PlanCatalogService PlanCatalog
@inject NavigationService Navigation

<PageTitle>Dưỡng Nhan — AI phân tích da</PageTitle>

<section class="dn-hero">
    <div class="container dn-container">
        <div class="row align-items-center g-5">
            <div class="col-lg-7" data-reveal="left">
                <span class="dn-kicker">AI Skin Intelligence</span>
                <h1 class="dn-display">Hiểu làn da của bạn.<br /><span class="dn-accent">Chăm sóc đúng cách.</span></h1>
                <p class="dn-lead">Phân tích da bằng AI, gợi ý sản phẩm phù hợp và theo dõi tiến triển — tất cả trong một nền tảng.</p>

                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a href="/scan" class="btn btn-dn-coral btn-lg dn-btn">
                        <i class="ph ph-scan" aria-hidden="true"></i>Phân tích da miễn phí
                    </a>
                    <a href="/recommendations" class="btn btn-dn-outline btn-lg dn-btn">
                        <i class="ph ph-sparkle" aria-hidden="true"></i>Routine theo loại da
                    </a>
                    @* <a href="/doctors" class="btn btn-dn-outline btn-lg dn-btn">
                        <i class="ph ph-stethoscope" aria-hidden="true"></i>Tìm bác sĩ
                    </a> *@
                </div>

                <ul class="dn-hero-points">
                    <li><i class="ph ph-check" aria-hidden="true"></i>Không cần thẻ thanh toán</li>
                    <li><i class="ph ph-check" aria-hidden="true"></i>Kết quả trong vài giây</li>
                    <li><i class="ph ph-check" aria-hidden="true"></i>Theo dõi lịch sử</li>
                </ul>
            </div>

            <div class="col-lg-5" data-reveal="right">
                <div class="dn-hero-art">
                    <img class="dn-hero-main" src="/images/hero-art.svg" alt="Bộ sản phẩm chăm sóc da" />
                    <div class="dn-polaroid a"><img src="https://images.unsplash.com/photo-1620916566398-39f1143ab7be?w=300&q=70&auto=format&fit=crop" alt="" loading="lazy" onerror="this.style.display='none'" /></div>
                    <div class="dn-polaroid b"><img src="https://images.unsplash.com/photo-1598440947619-2c35fc9aa908?w=300&q=70&auto=format&fit=crop" alt="" loading="lazy" onerror="this.style.display='none'" /></div>
                    <div class="dn-score-chip"><i class="ph-fill ph-sparkle" aria-hidden="true"></i> Skin Score 92</div>
                </div>
            </div>
        </div>
    </div>
</section>
<svg class="dn-wave" viewBox="0 0 1440 56" preserveAspectRatio="none" aria-hidden="true"><path fill="currentColor" d="M0 0h1440v20c-240 44-480 44-720 20S240-8 0 28Z" transform="scale(1 1)"/></svg>

<section class="dn-section" id="routine">
    <div class="container dn-container">
        <div class="text-center dn-section-heading" data-reveal>
            <span class="dn-kicker">Routine 5 bước</span>
            <h2>Sắp xếp sản phẩm đúng thứ tự</h2>
            <p>Mỗi bước có vai trò riêng. Chọn sản phẩm phù hợp loại da của bạn để routine hiệu quả và dịu nhẹ.</p>
        </div>
        <div class="dn-routine">
            @foreach (var (step, i) in SkincareCatalog.Steps.Where(x => x.Number <= 5).Select((x, i) => (x, i)))
            {
                <a class="dn-routine-item" href="/recommendations#step-@step.Number" data-reveal="zoom" style="--dn-delay:@(i * 90)ms">
                    <img src="/images/step-@(step.Code).svg" alt="" loading="lazy" />
                    <b>@step.Number. @step.Label</b>
                    <small>@step.When</small>
                </a>
            }
        </div>
    </div>
</section>

<section class="dn-section dn-soft-section">
    <div class="container dn-container">
        <div class="text-center dn-section-heading" data-reveal>
            <span class="dn-kicker">Tất cả trong một</span>
            <h2>Chăm sóc da dựa trên dữ liệu</h2>
            <p>Không đoán mò. Dưỡng Nhan kết nối phân tích AI, thành phần an toàn và gợi ý sản phẩm phù hợp thành một quy trình đơn giản.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="dn-feature-card" data-reveal>
                    <div class="dn-icon coral"><i class="ph ph-scan" aria-hidden="true"></i></div>
                    <h5>AI Skin Scan</h5>
                    <p>Tải ảnh da để nhận phân tích tình trạng, mức độ và các vấn đề có thể gặp.</p>
                    <a href="/scan" class="dn-link">Bắt đầu scan<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dn-feature-card" data-reveal>
                    <div class="dn-icon teal"><i class="ph ph-flask" aria-hidden="true"></i></div>
                    <h5>Routine cá nhân</h5>
                    <p>Nhận đề xuất sản phẩm theo vấn đề da và theo dõi tiến triển theo thời gian.</p>
                    <a href="/products" class="dn-link">Xem sản phẩm<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
            <div class="col-md-4">
                <div class="dn-feature-card" data-reveal>
                    <div class="dn-icon dark"><i class="ph ph-chart-line-up" aria-hidden="true"></i></div>
                    <h5>Theo dõi tiến trình</h5>
                    <p>Lưu lịch sử quét AI và xem biểu đồ phục hồi làn da trực quan theo từng tuần sử dụng.</p>
                    <a href="/history" class="dn-link">Xem tiến trình<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="dn-section dn-soft-section">
    <div class="container dn-container">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="dn-kicker">Quy trình</span>
                <h2 class="dn-display-sm">Từ một bức ảnh đến kế hoạch chăm sóc.</h2>

                <div class="dn-step" data-reveal="left">
                    <span>01</span>
                    <div><h6>Chụp hoặc tải ảnh</h6><p>Ảnh rõ, đủ sáng giúp AI phân tích chính xác hơn.</p></div>
                </div>
                <div class="dn-step" data-reveal="left">
                    <span>02</span>
                    <div><h6>AI phân tích</h6><p>Hệ thống đánh giá tình trạng và mức độ các vấn đề da.</p></div>
                </div>
                <div class="dn-step" data-reveal="left">
                    <span>03</span>
                    <div><h6>Hành động</h6><p>Nhận gợi ý chăm sóc, sản phẩm để cải thiện da.</p></div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="dn-analysis-preview" data-reveal="right">
                    <div class="dn-analysis-top">
                        <span>Latest analysis</span>
                        <b>92%</b>
                    </div>
                    <div class="progress mb-4" style="height:8px">
                        <div class="progress-bar bg-success" style="width:92%"></div>
                    </div>
                    <div class="row g-2">
                        <div class="col-4"><div class="mini-stat"><small>Acne</small><strong>Low</strong></div></div>
                        <div class="col-4"><div class="mini-stat"><small>Hydration</small><strong>Good</strong></div></div>
                        <div class="col-4"><div class="mini-stat"><small>Barrier</small><strong>Good</strong></div></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="dn-section dn-soft-section">
    <div class="container dn-container">
        <div class="text-center dn-section-heading" data-reveal>
            <span class="dn-kicker">Bảng giá</span>
            <h2>Chọn gói phù hợp với bạn</h2>
            <p>Bắt đầu miễn phí, nâng cấp bất cứ lúc nào khi bạn cần theo dõi da sát sao hơn.</p>
        </div>

        @if (loadingPlans)
        {
            <div class="text-center py-4"><div class="spinner-border text-success"></div></div>
        }
        else if (plans.Count == 0)
        {
            <p class="text-center text-secondary">Chưa có gói nào khả dụng — hãy quay lại sau.</p>
        }
        else
        {
            <div class="dn-plan-grid" data-reveal>
                @foreach (var plan in plans)
                {
                    <PlanCard Plan="plan" OnChoose="GoToPricing" />
                }
            </div>

            <div class="text-center mt-4">
                <a href="/pricing" class="dn-link justify-content-center">Xem đầy đủ tính năng từng gói<i class="ph ph-arrow-right" aria-hidden="true"></i></a>
            </div>
        }
    </div>
</section>

<section class="dn-section">
    <div class="container dn-container">
        <div class="dn-dark-cta" data-reveal="zoom">
            <div>
                <span class="dn-kicker">Bắt đầu hôm nay</span>
                <h2>Đừng đoán về làn da.</h2>
                <p>Hãy bắt đầu bằng một lần phân tích miễn phí.</p>
            </div>
            <a href="/scan" class="btn btn-dn-coral btn-lg dn-btn">
                <i class="ph ph-arrow-right" aria-hidden="true"></i>Tạo tài khoản &amp; Scan ngay
            </a>
        </div>
    </div>
</section>


@code {
    private List<System.Text.Json.JsonElement> plans = [];
    private bool loadingPlans = true;

    private readonly CancellationTokenSource cts = new();

    protected override async Task OnInitializedAsync()
    {
        try { plans = await PlanCatalog.GetPlansAsync(cts.Token); }
        catch { /* the teaser is optional decoration — /pricing still works if this fails */ }
        finally { loadingPlans = false; }
    }

    // Leaving the page cancels only this page's request; cancellation is expected, not an error.
    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    private void GoToPricing() => Navigation.NavigateTo("/pricing");

}
