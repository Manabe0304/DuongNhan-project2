@page "/dashboard"
@inject DuongNhanApiService Api
@inject UiSessionService Session

<div class="container dn-container dn-page">
    <div class="dn-page-heading d-flex flex-wrap justify-content-between align-items-end gap-3 mb-4">
        <div>
            <span class="dn-kicker">Customer Portal</span>
            <h1>Xin chào, @(Session.Name ?? "bạn")</h1>
            <p>Quản lý phân tích da, sản phẩm và lịch tư vấn của bạn.</p>
        </div>
        <a href="/scan" class="btn btn-dn-coral dn-btn">
            <i class="ph ph-scan" aria-hidden="true"></i>Phân tích da
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="dn-stat-card">
                <small>AI Skin Score</small>
                <strong>92</strong>
                <span><i class="ph ph-chart-line-up dn-inline-icon" aria-hidden="true"></i>+4 so với lần trước</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dn-stat-card">
                <small>Lần scan</small>
                <strong>@scanCount</strong>
                <span><i class="ph ph-timer dn-inline-icon" aria-hidden="true"></i>Trong lịch sử</span>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dn-stat-card">
                <small>Gói hiện tại</small>
                <strong>@plan</strong>
                <span><i class="ph ph-seal-check dn-inline-icon" aria-hidden="true"></i>Đang hoạt động</span>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="dn-card p-4">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <h5 class="mb-1">Hoạt động gần đây</h5>
                        <p class="small text-secondary mb-0">Kết quả phân tích mới nhất của bạn.</p>
                    </div>
                    <a href="/history" class="dn-link small">
                        Xem tất cả<i class="ph ph-arrow-right" aria-hidden="true"></i>
                    </a>
                </div>

                @if (history.Count == 0)
                {
                    <div class="dn-empty py-4">
                        <p class="mb-3">Bạn chưa có lần phân tích nào.</p>
                        <a href="/scan" class="btn btn-dn-coral btn-sm dn-btn">
                            <i class="ph ph-scan" aria-hidden="true"></i>Thực hiện scan đầu tiên
                        </a>
                    </div>
                }
                else
                {
                    @foreach (var item in history.Take(3))
                    {
                        <div class="dn-history-row">
                            <div class="dn-history-icon">
                                <i class="ph-fill ph-check-circle" aria-hidden="true"></i>
                            </div>
                            <div class="dn-history-body">
                                <b>@Text(item, "primaryCondition", "Skin analysis")</b>
                                <small>@Text(item, "diagnosedAt", "")</small>
                            </div>
                            <span class="badge bg-success-subtle text-success">@Text(item, "severity", "—")</span>
                        </div>
                    }
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="dn-card p-4">
                <h5 class="mb-3">Thao tác nhanh</h5>

                <a class="dn-quick" href="/scan">
                    <span class="dn-quick-icon"><i class="ph ph-camera" aria-hidden="true"></i></span>
                    <span><b>Scan da mới</b><small>Phân tích tình trạng hiện tại</small></span>
                </a>
                <a class="dn-quick" href="/products">
                    <span class="dn-quick-icon"><i class="ph ph-flask" aria-hidden="true"></i></span>
                    <span><b>Sản phẩm</b><small>Xem gợi ý chăm sóc</small></span>
                </a>
                <a class="dn-quick" href="/doctors">
                    <span class="dn-quick-icon"><i class="ph ph-stethoscope" aria-hidden="true"></i></span>
                    <span><b>Bác sĩ</b><small>Đặt lịch tư vấn</small></span>
                </a>
                <a class="dn-quick" href="/profile">
                    <span class="dn-quick-icon"><i class="ph ph-user" aria-hidden="true"></i></span>
                    <span><b>Hồ sơ</b><small>Cập nhật thông tin</small></span>
                </a>
            </div>
        </div>
    </div>
</div>

@code {
    private List<System.Text.Json.JsonElement> history = [];
    private string plan = "Free";
    private int scanCount;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            history = await Api.GetHistoryAsync();
            scanCount = history.Count;

            var subscription = await Api.GetCurrentSubscriptionAsync();
            if (subscription is { } element)
                plan = Text(element, "tier", Text(element, "name", "Free"));
        }
        catch
        {
            // Dashboard is a summary view; individual failures fall back to defaults.
        }
    }

    private static string Text(System.Text.Json.JsonElement item, string name, string fallback)
    {
        foreach (var key in new[] { name, char.ToUpperInvariant(name[0]) + name[1..] })
        {
            if (item.TryGetProperty(key, out var property))
                return property.ToString();
        }

        return fallback;
    }
}