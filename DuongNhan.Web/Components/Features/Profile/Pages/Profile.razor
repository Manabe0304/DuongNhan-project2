@page "/profile"
@implements IDisposable
@inject UiSessionService Session
@inject NavigationService Navigation
@inject UsageState Usage

<PageTitle>Hồ sơ cá nhân — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <section class="dn-pagehead" data-reveal>
        <div>
            <span class="dn-kicker">Tài khoản &amp; hồ sơ da</span>
            <h1>Hồ sơ cá nhân</h1>
            <p>Quản lý thông tin tài khoản, loại da và bảo mật của bạn.</p>
        </div>
    </section>

    <div class="row g-4">
        <div class="col-lg-4" data-reveal>
            <aside class="dn-card dn-profile-card">
                <div class="dn-avatar dn-avatar-lg">@Initial</div>
                <h2 class="dn-profile-name">@(Session.Name ?? "Tài khoản")</h2>
                <p class="dn-profile-email">@Session.Email</p>

                @if (Usage.Current is { } u)
                {
                    <span class="dn-plan-badge"><i class="ph ph-crown-simple" aria-hidden="true"></i> Gói @u.PlanName</span>

                    <div class="dn-usage-meter" role="img" aria-label="@(u.IsUnlimited ? "Không giới hạn lượt quét" : $"Đã dùng {u.ScansUsed} trên {u.ScansLimit} lượt quét")">
                        <div class="dn-usage-meter-top"><span>Lượt quét tháng này</span><b>@u.UsageLabel</b></div>
                        <div class="dn-usage-meter-bar"><span style="width:@UsagePercent(u)%"></span></div>
                    </div>
                }

                <dl class="dn-profile-facts">
                    <div><dt>Loại da khai báo</dt><dd>@(skinType is null ? "Chưa xác định" : SkincareCatalog.SkinTypeLabel(skinType))</dd></div>
                </dl>

                <a href="/pricing" class="btn btn-dn-outline w-100"><i class="ph ph-sparkle" aria-hidden="true"></i> Nâng cấp gói quét</a>
                <div class="dn-profile-links">
                    <a href="/history"><i class="ph ph-clock-counter-clockwise" aria-hidden="true"></i> Lịch sử phân tích</a>
                    <a href="/recommendations"><i class="ph ph-sparkle" aria-hidden="true"></i> Gợi ý cho tôi</a>
                </div>
            </aside>
        </div>

        <div class="col-lg-8" data-reveal style="--dn-delay:80ms">
            <div class="dn-card p-4 p-lg-5">
                <div class="dn-tabs" role="tablist" aria-label="Cài đặt tài khoản">
                    <button type="button" role="tab" id="tab-info" aria-selected="@(tab == Tab.Info ? "true" : "false")" aria-controls="panel-info" @onclick="() => tab = Tab.Info">
                        <i class="ph ph-user-circle" aria-hidden="true"></i><span>Thông tin cá nhân</span>
                    </button>
                    <button type="button" role="tab" id="tab-password" aria-selected="@(tab == Tab.Password ? "true" : "false")" aria-controls="panel-password" @onclick="() => tab = Tab.Password">
                        <i class="ph ph-key" aria-hidden="true"></i><span>Đổi mật khẩu</span>
                    </button>
                </div>

                <div role="tabpanel" id="panel-info" aria-labelledby="tab-info" hidden="@(tab != Tab.Info)">
                    <ProfileForm OnSaved="OnSkinTypeChanged" OnSkinTypeLoaded="OnSkinTypeChanged" />
                </div>
                <div role="tabpanel" id="panel-password" aria-labelledby="tab-password" hidden="@(tab != Tab.Password)">
                    @if (tab == Tab.Password)
                    {
                        <ChangePasswordForm />
                    }
                </div>

                <hr class="my-4" />
                <a class="dn-danger-link" href="/delete-account"><i class="ph ph-warning-circle" aria-hidden="true"></i> Xoá tài khoản (không thể hoàn tác)</a>
            </div>
        </div>
    </div>
</div>

@code {
    private enum Tab { Info, Password }

    private Tab tab = Tab.Info;
    private string? skinType;

    private string Initial => string.IsNullOrWhiteSpace(Session.Name) ? "D" : Session.Name.Trim()[..1].ToUpperInvariant();

    private static int UsagePercent(DuongNhan.Shared.Dtos.Subscriptions.UsageCounterDto u)
        => u.ScansLimit <= 0 ? 0 : Math.Clamp(u.ScansUsed * 100 / u.ScansLimit, 0, 100);

    protected override void OnInitialized()
    {
        Usage.Changed += HandleUsageChanged;

        if (!Session.IsAuthenticated)
            Navigation.NavigateTo("/login");
    }

    private void HandleUsageChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnSkinTypeChanged(string? code)
    {
        skinType = code;
        StateHasChanged();
    }

    public void Dispose() => Usage.Changed -= HandleUsageChanged;
}
