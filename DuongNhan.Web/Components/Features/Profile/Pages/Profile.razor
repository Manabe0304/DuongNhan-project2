@page "/profile"
@inject UiSessionService Session

<div class="container dn-container dn-page">
    <div class="dn-page-heading"><span class="dn-kicker">Account</span><h1>Hồ sơ cá nhân</h1><p>Quản lý thông tin tài khoản của bạn.</p></div>
    <div class="row g-4"><div class="col-lg-8"><div class="dn-card p-4 p-lg-5">
        <div class="d-flex align-items-center gap-3 mb-4"><div class="dn-avatar">@(Session.Name?.FirstOrDefault().ToString().ToUpper() ?? "D")</div><div><h5 class="mb-1">@Session.Name</h5><small class="text-secondary">@Session.Email</small></div></div>
        <div class="row g-3"><div class="col-md-6"><label class="form-label small">Họ và tên</label><input class="form-control" value="@Session.Name" /></div><div class="col-md-6"><label class="form-label small">Email</label><input class="form-control" value="@Session.Email" disabled /></div><div class="col-md-6"><label class="form-label small">Số điện thoại</label><input class="form-control" placeholder="09xx xxx xxx" /></div><div class="col-md-6"><label class="form-label small">Loại da</label><select class="form-select"><option>Chưa xác định</option><option>Da dầu</option><option>Da khô</option><option>Da hỗn hợp</option><option>Da nhạy cảm</option></select></div></div>
        <button class="btn btn-dn-coral mt-4">Lưu thay đổi</button>
    </div></div><div class="col-lg-4"><div class="dn-card p-4"><h6>Bảo mật</h6><a class="dn-quick" href="/change-password">🔒 <span><b>Đổi mật khẩu</b><small>Cập nhật mật khẩu</small></span></a><a class="dn-quick text-danger" href="/delete-account">⚠ <span><b>Xóa tài khoản</b><small>Thao tác không thể hoàn tác</small></span></a></div></div></div>
</div>
