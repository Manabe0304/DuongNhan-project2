@page "/change-password"
@inject UiSessionService Session
@inject NavigationService Navigation

<PageTitle>Đổi mật khẩu — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">Bảo mật</span>
        <h1>Đổi mật khẩu</h1>
        <p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="dn-card p-4 p-lg-5">
                <ChangePasswordForm />
                <a href="/profile" class="btn btn-dn-outline w-100 mt-3" id="btn-cancel">Về hồ sơ</a>
            </div>
        </div>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
            Navigation.NavigateTo("/login");
    }
}
