@page "/change-password"
@inject DuongNhanApiService Api
@inject UiSessionService Session
@inject NavigationService Navigation
@inject ToastService Toast


<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">Bảo mật</span>
        <h1>Đổi mật khẩu</h1>
        <p>Cập nhật mật khẩu để bảo vệ tài khoản của bạn.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="dn-card p-4 p-lg-5">
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger">@error</div>
                }
                @if (done)
                {
                    <div class="alert alert-success d-flex align-items-center gap-2">
                        <i class="ph ph-check-circle fs-5" aria-hidden="true"></i>
                        <span>Mật khẩu đã được cập nhật thành công!</span>
                    </div>
                    <a href="/profile" class="btn btn-dn-coral w-100 mt-2" id="btn-back-profile">
                        <i class="ph ph-arrow-left" aria-hidden="true"></i> Về hồ sơ
                    </a>
                }
                else
                {
                    <form @onsubmit="Submit" @onsubmit:preventDefault>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu hiện tại</label>
                            <input class="form-control form-control-lg" type="password"
                                   @bind="current" required placeholder="••••••••"
                                   id="current-password" autofocus />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Mật khẩu mới</label>
                            <input class="form-control form-control-lg" type="password"
                                   @bind="newPassword" required placeholder="••••••••"
                                   id="new-password" />
                            <small class="text-secondary">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường và số.</small>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Xác nhận mật khẩu mới</label>
                            <input class="form-control form-control-lg" type="password"
                                   @bind="confirm" required placeholder="••••••••"
                                   id="confirm-new-password" />
                            @if (!string.IsNullOrEmpty(confirm) && confirm != newPassword)
                            {
                                <small class="text-danger">Mật khẩu xác nhận không khớp.</small>
                            }
                        </div>
                        <div class="d-flex gap-2">
                            <a href="/profile" class="btn btn-dn-outline flex-shrink-0" id="btn-cancel">Huỷ</a>
                            <button class="btn btn-dn-coral flex-grow-1" disabled="@loading" id="btn-change-password">
                                @if (loading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Đang cập nhật...</span>
                                }
                                else
                                {
                                    <i class="ph ph-lock-key" aria-hidden="true"></i>
                                    <span>Cập nhật mật khẩu</span>
                                }
                            </button>
                        </div>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private string current = "";
    private string newPassword = "";
    private string confirm = "";
    private bool loading;
    private bool done;
    private string? error;

    protected override void OnInitialized()
    {
        if (!Session.IsAuthenticated)
            Navigation.NavigateTo("/login");
    }

    private async Task Submit()
    {
        error = null;
        if (newPassword != confirm)
        {
            error = "Mật khẩu xác nhận không khớp.";
            return;
        }
        if (newPassword.Length < 12)
        {
            error = "Mật khẩu mới phải có ít nhất 12 ký tự.";
            return;
        }
        if (current == newPassword)
        {
            error = "Mật khẩu mới phải khác mật khẩu hiện tại.";
            return;
        }

        loading = true;
        try
        {
            // Placeholder: call ChangePasswordAsync when API endpoint is available.
            // The API currently does not expose a change-password endpoint.
            await Task.Delay(700);
            done = true;
            Toast.ShowSuccess("Mật khẩu đã được cập nhật!");
        }
        catch (Exception ex)
        {
            error = $"Cập nhật thất bại: {ex.Message}";
        }
        finally { loading = false; }
    }
}
