@inject DuongNhanApiService Api
@inject UiSessionService Session
@inject NavigationService Navigation
@inject ToastService Toast
@inject UsageState Usage

@* Real password change (PUT /api/users/me/password). Other sessions are revoked, so the user signs in again. *@
@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger small" role="alert">@error</div>
}

@if (done)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="status">
        <i class="ph ph-check-circle fs-5" aria-hidden="true"></i>
        <span>Đã đổi mật khẩu. Vui lòng đăng nhập lại...</span>
    </div>
}
else
{
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="mb-3">
            <label class="form-label small fw-semibold" for="current-password">Mật khẩu hiện tại</label>
            <input class="form-control" type="password" autocomplete="current-password" @bind="current" required id="current-password" />
        </div>
        <div class="mb-3">
            <label class="form-label small fw-semibold" for="new-password">Mật khẩu mới</label>
            <input class="form-control" type="password" autocomplete="new-password" @bind="newPassword" required id="new-password" />
            <small class="text-secondary">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường và số.</small>
        </div>
        <div class="mb-4">
            <label class="form-label small fw-semibold" for="confirm-new-password">Xác nhận mật khẩu mới</label>
            <input class="form-control" type="password" autocomplete="new-password" @bind="confirm" required id="confirm-new-password" />
            @if (!string.IsNullOrEmpty(confirm) && confirm != newPassword)
            {
                <small class="text-danger">Mật khẩu xác nhận không khớp.</small>
            }
        </div>
        <button class="btn btn-dn-coral" disabled="@loading" id="btn-change-password">
            @if (loading)
            {
                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                <span>Đang cập nhật...</span>
            }
            else
            {
                <i class="ph ph-lock-key" aria-hidden="true"></i>
                <span>Cập nhật mật khẩu</span>
            }
        </button>
    </form>
}

@code {
    private string current = "";
    private string newPassword = "";
    private string confirm = "";
    private bool loading;
    private bool done;
    private string? error;

    private async Task SubmitAsync()
    {
        error = null;

        if (newPassword != confirm) { error = "Mật khẩu xác nhận không khớp."; return; }
        if (newPassword.Length < 12) { error = "Mật khẩu mới phải có ít nhất 12 ký tự."; return; }
        if (current == newPassword) { error = "Mật khẩu mới phải khác mật khẩu hiện tại."; return; }

        loading = true;
        try
        {
            await Api.ChangePasswordAsync(current, newPassword);
            done = true;
            Toast.ShowSuccess("Đã đổi mật khẩu. Hãy đăng nhập lại.");

            // The API revoked every session, including this one.
            await Task.Delay(1200);
            Usage.Clear();
            await Session.SignOutAsync();
            Navigation.NavigateTo("/login");
        }
        catch (Refit.ApiException ex)
        {
            error = ReadApiError(ex) ?? "Không thể đổi mật khẩu. Vui lòng kiểm tra lại mật khẩu hiện tại.";
        }
        catch (Exception ex)
        {
            error = $"Cập nhật thất bại: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    /// <summary>Pulls the first validation message out of a FastEndpoints error body.</summary>
    private static string? ReadApiError(Refit.ApiException ex)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(ex.Content ?? "{}");
            if (doc.RootElement.TryGetProperty("errors", out var errors) && errors.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                foreach (var group in errors.EnumerateObject())
                    foreach (var message in group.Value.EnumerateArray())
                        return message.GetString();
            }
        }
        catch { /* fall back to the generic message */ }

        return null;
    }
}
