@page "/products"
@inject DuongNhanApiService Api
@inject BrowserStorage Storage
@inject AnalyticsService Analytics
@inject IJSRuntime JS

<PageTitle>Sản phẩm chăm sóc da — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <section class="dn-pagehead" data-reveal>
        <div>
            <span class="dn-kicker">Shopee Mall chính hãng</span>
            <h1>Sản phẩm chăm sóc da</h1>
            <p>Lọc theo loại da và bước trong routine để chọn đúng sản phẩm. Muốn gợi ý riêng cho làn da của bạn?</p>
        </div>
        <a href="/recommendations" class="btn btn-dn-coral dn-btn"><i class="ph ph-sparkle" aria-hidden="true"></i> Gợi ý cho riêng bạn</a>
    </section>

    <div class="dn-toolbar" data-reveal>
        <div class="dn-search">
            <i class="ph ph-magnifying-glass" aria-hidden="true"></i>
            <input class="form-control" placeholder="Tìm theo tên hoặc thương hiệu..." @bind="query" @bind:event="oninput" aria-label="Tìm sản phẩm" />
        </div>
        <select class="form-select dn-sort" @bind="sort" aria-label="Sắp xếp">
            <option value="default">Sắp xếp: Theo routine</option>
            <option value="price-asc">Giá: thấp đến cao</option>
            <option value="price-desc">Giá: cao đến thấp</option>
            <option value="name">Tên A → Z</option>
        </select>
    </div>

    <div class="dn-filters" data-reveal>
        <div class="dn-chips" role="group" aria-label="Loại da">
            <button type="button" class="dn-chip-skin" aria-pressed="@Pressed(skinType is null)" @onclick="() => SelectSkinTypeAsync(null)">Mọi loại da</button>
            @foreach (var t in SkincareCatalog.SkinTypes)
            {
                var code = t.Code;
                <button type="button" class="dn-chip-skin" aria-pressed="@Pressed(skinType == code)" @onclick="() => SelectSkinTypeAsync(code)">@t.Label</button>
            }
        </div>

        <div class="dn-steprow" role="group" aria-label="Bước trong routine">
            <button type="button" class="dn-stepchip" aria-pressed="@Pressed(stepFilter == 0)" @onclick="() => stepFilter = 0">Tất cả</button>
            @foreach (var step in SkincareCatalog.Steps)
            {
                var n = step.Number;
                <button type="button" class="dn-stepchip" aria-pressed="@Pressed(stepFilter == n)" @onclick="() => stepFilter = n" title="@step.Label">
                    <StepIcon Step="n" /><span>@step.Label</span>
                </button>
            }
        </div>
    </div>

    @if (loading)
    {
        <div class="dn-card p-5 text-center"><div class="spinner-border text-success" role="status"></div></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-warning">@error</div>
    }
    else
    {
        var shown = Filtered;
        var totalPages = Math.Max(1, (int)Math.Ceiling(shown.Count / (double)PageSize));
        var current = Math.Clamp(page, 1, totalPages); // the list can shrink under us (filters), never show an empty page
        var pageItems = shown.Skip((current - 1) * PageSize).Take(PageSize).ToList();
        <p id="products-top" class="dn-count dn-scroll-anchor" role="status">@shown.Count sản phẩm</p>

        @if (shown.Count == 0)
        {
            <div class="dn-step-empty text-center">Không có sản phẩm nào khớp bộ lọc. Hãy thử chọn “Mọi loại da” hoặc “Tất cả” bước.</div>
        }
        else
        {
            <div class="dn-pgrid">
                @for (var i = 0; i < pageItems.Count; i++)
                {
                    var item = pageItems[i];
                    <div data-reveal style="--dn-delay:@(i % 3 * 70)ms">
                        <ProductCard Product="item" OnOpen="TrackOpenAsync" />
                    </div>
                }
            </div>

            <Pagination Page="current" TotalPages="totalPages" TotalItems="shown.Count" PageSize="PageSize"
                        PageChanged="GoToPageAsync" />
        }
    }
</div>

@code {
    private const string SkinTypeKey = "dn.skin_type";

    // 20 fills the 1/2/4-column grid evenly (5 rows on desktop); 3-column widths end on a short last row.
    private const int PageSize = 20;

    private List<ProductCardModel> items = [];
    private int page = 1;

    // Changing any filter/sort/search returns to page 1 (otherwise the visitor could land on an empty page).
    private string queryValue = "";
    private string sortValue = "default";
    private string? skinTypeValue;
    private int stepFilterValue;

    private string query { get => queryValue; set { queryValue = value; page = 1; } }
    private string sort { get => sortValue; set { sortValue = value; page = 1; } }
    private string? skinType { get => skinTypeValue; set { skinTypeValue = value; page = 1; } }
    private int stepFilter { get => stepFilterValue; set { stepFilterValue = value; page = 1; } }
    private bool loading = true;
    private string? error;

    private static string Pressed(bool on) => on ? "true" : "false";

    private List<ProductCardModel> Filtered
    {
        get
        {
            var list = items
                .Where(p => SkincareCatalog.SuitsSkinType(p.SkinTypes, skinType))
                .Where(p => stepFilter == 0 || p.Step == stepFilter)
                .Where(p => string.IsNullOrWhiteSpace(query)
                    || p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                    || p.Brand.Contains(query, StringComparison.OrdinalIgnoreCase));

            return (sort switch
            {
                "price-asc" => list.OrderBy(p => p.Price),
                "price-desc" => list.OrderByDescending(p => p.Price),
                "name" => list.OrderBy(p => p.Name),
                _ => list.OrderBy(p => p.Step).ThenBy(p => p.Name)
            }).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            items = (await Api.GetProductsAsync()).Select(e => ProductCardModel.FromJson(e)).ToList();
        }
        catch (Exception ex)
        {
            error = $"Không tải được sản phẩm: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Same preference the profile page saves; browser storage is only readable after the first render.
        try
        {
            var saved = await Storage.GetAsync(SkinTypeKey);
            if (SkincareCatalog.SkinTypes.Any(t => t.Code == saved))
            {
                skinType = saved;
                StateHasChanged();
            }
        }
        catch { /* optional convenience */ }
    }

    private async Task GoToPageAsync(int newPage)
    {
        page = newPage;
        try { await JS.InvokeVoidAsync("dnScrollToId", "products-top"); }
        catch { /* scrolling is a nicety */ }
    }

    private async Task SelectSkinTypeAsync(string? code)
    {
        skinType = code;
        try
        {
            if (code is null) await Storage.RemoveAsync(SkinTypeKey);
            else await Storage.SetAsync(SkinTypeKey, code);
        }
        catch { /* not persisting is fine */ }
    }

    private async Task TrackOpenAsync(ProductCardModel item)
    {
        await Analytics.EventAsync("select_item", new { item_id = item.Id?.ToString(), item_name = item.Name, destination = "shopee" });
        await Analytics.EventAsync("affiliate_click", new { item_id = item.Id?.ToString(), item_name = item.Name, item_category = item.Category });
    }
}
