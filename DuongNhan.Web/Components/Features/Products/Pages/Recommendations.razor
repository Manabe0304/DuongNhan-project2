@page "/products"
@page "/recommendations"
@inject DuongNhanApiService Api
@inject NavigationManager NavManager
@inject UiSessionService Session
@inject IJSRuntime JS
@inject ProductExcelParser ExcelParser

<div class="container dn-container dn-page">
    <div class="dn-page-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
        <div><span class="dn-kicker">Dermacare</span><h1>Sản phẩm chăm sóc da</h1><p>Khám phá sản phẩm và lựa chọn phù hợp với nhu cầu làn da của bạn.</p></div>
        <div class="d-flex flex-column gap-2">
            <div class="dn-search"><input class="form-control" placeholder="Tìm sản phẩm..." @bind="query" @bind:event="oninput" /></div>
            @if (Session.IsAdmin)
            {
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <label class="btn btn-dn-coral btn-sm mb-0 @(importing ? "disabled" : "")">
                        <i class="ph ph-upload-simple" aria-hidden="true"></i> @(importing ? "Đang import..." : "Import Excel")
                        <InputFile OnChange="OnImportFileSelected" accept=".xlsx" class="d-none" disabled="@importing" />
                    </label>
                    <a class="small" href="#" @onclick="DownloadTemplate" @onclick:preventDefault>Tải file mẫu</a>
                </div>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(importMessage))
    {
        <div class="alert @(importFailed ? "alert-danger" : "alert-success") mt-3">@importMessage</div>
    }

    @if (loading)
    {
        <div class="dn-card p-5 text-center"><div class="spinner-border text-success"></div></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {

        <div class="alert alert-warning">@error</div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Filtered)
            {
                <div class="col-sm-6 col-xl-3">
                    <div class="dn-product-card h-100">
                        <div class="dn-product-img"><img src="@Text(p, "image", Text(p, "imageUrl", "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600"))" alt="" /></div>
                        <div class="p-3 d-flex flex-column h-auto">
                            <small class="text-secondary">@Text(p, "brand", "DuongNhan")</small>
                            <h6 class="mt-1 mb-2">@Text(p, "name", "Skin care product")</h6>
                            <div class="d-flex align-items-center justify-content-between mb-3"><span class="fw-bold">@Text(p, "price", "—")</span><span class="small dn-rating"><i class="ph-fill ph-star" aria-hidden="true"></i>@Text(p, "rating", "4.8")</span></div>
                            <button type="button" @onclick="() => OpenAffiliate(Affiliate(p))" class="btn btn-dn-coral btn-sm mt-auto">Xem sản phẩm</button>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<System.Text.Json.JsonElement> items = [];
    private string query = "";
    private bool loading = true;
    private string? error;

    private IEnumerable<System.Text.Json.JsonElement> Filtered
        => items.Where(x => string.IsNullOrWhiteSpace(query)
            || Text(x, "name", "").Contains(query, StringComparison.OrdinalIgnoreCase)
            || Text(x, "brand", "").Contains(query, StringComparison.OrdinalIgnoreCase));

    private bool importing;
    private bool importFailed;
    private string? importMessage;
    private const long MaxImportBytes = 5 * 1024 * 1024;

    protected override async Task OnInitializedAsync() => await LoadProductsAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Browser storage (where the login token lives) is only readable after the first interactive render.
        if (firstRender)
        {
            await Session.LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadProductsAsync()
    {
        try { items = await Api.GetProductsAsync(); }
        catch (Exception ex) { error = $"Không tải được sản phẩm từ Product API: {ex.Message}"; }
        finally { loading = false; }
    }

    private async Task OnImportFileSelected(InputFileChangeEventArgs e)
    {
        importMessage = null;
        importFailed = false;
        importing = true;

        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
            {
                Fail("Chỉ hỗ trợ file .xlsx.");
                return;
            }

            using var buffer = new MemoryStream();
            await using (var stream = file.OpenReadStream(MaxImportBytes))
                await stream.CopyToAsync(buffer);
            buffer.Position = 0;

            var parsed = ExcelParser.Parse(buffer);
            if (parsed.Rows.Count == 0)
            {
                Fail(string.Join(" ", parsed.Errors.Take(5)));
                return;
            }

            var result = await Api.ImportProductsAsync(parsed.Rows);
            await LoadProductsAsync();

            var skipped = parsed.Errors.Count + result.Skipped;
            importMessage = $"Import thành công: {result.Created} sản phẩm mới, {result.Updated} cập nhật."
                + (skipped > 0 ? $" Bỏ qua {skipped} dòng lỗi. {string.Join(" ", parsed.Errors.Take(3))}" : "");
        }
        catch (Exception ex)
        {
            Fail($"Import thất bại: {ex.Message}");
        }
        finally
        {
            importing = false;
        }
    }

    private void Fail(string message)
    {
        importFailed = true;
        importMessage = message;
    }

    private async Task DownloadTemplate()
    {
        var bytes = ExcelParser.BuildTemplate();
        using var stream = new DotNetStreamReference(new MemoryStream(bytes));
        await JS.InvokeVoidAsync("dnDownloadFile", "products-import-template.xlsx", stream);
    }

    private static string Text(System.Text.Json.JsonElement item, string name, string fallback)
    {
        foreach (var key in new[] { name, char.ToUpperInvariant(name[0]) + name[1..] })
            if (item.TryGetProperty(key, out var p))
                return p.ValueKind == System.Text.Json.JsonValueKind.String ? p.GetString() ?? fallback : p.ToString();
        return fallback;
    }

    private static string Affiliate(System.Text.Json.JsonElement item)
        => Text(item, "affiliateUrl", "#");

    private void OpenAffiliate(string url)
    {
        if (!string.IsNullOrWhiteSpace(url) && url != "#")
        {
            NavManager.NavigateTo(url, forceLoad: true);
        }
    }
}
