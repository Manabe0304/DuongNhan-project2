@page "/recommendations"
@implements IAsyncDisposable
@inject DuongNhanApiService Api
@inject UiSessionService Session
@inject AnalyticsService Analytics
@inject IJSRuntime JS

<PageTitle>Gợi ý dành cho bạn — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <section class="dn-pagehead" data-reveal>
        <div>
            <span class="dn-kicker">Dành riêng cho bạn</span>
            <h1>Gợi ý chăm sóc cho làn da của bạn</h1>
            <p>Routine được sắp xếp theo từng bước, dựa trên kết quả phân tích da gần nhất của bạn.</p>
        </div>
        <a href="/products" class="btn btn-dn-outline dn-btn"><i class="ph ph-storefront" aria-hidden="true"></i> Xem toàn bộ sản phẩm</a>
    </section>

    @if (loading)
    {
        <div class="dn-card p-5 text-center"><div class="spinner-border text-success" role="status"></div></div>
    }
    else if (needLogin)
    {
        <div class="dn-empty" data-reveal>
            <i class="ph ph-lock-key dn-empty-icon" aria-hidden="true"></i>
            <h5>Đăng nhập để nhận gợi ý riêng</h5>
            <p>Gợi ý được tạo từ kết quả scan da của bạn. Đăng nhập hoặc tạo tài khoản để lưu lịch sử và xem routine phù hợp.</p>
            <div class="d-flex flex-wrap gap-2 justify-content-center">
                <a href="/login" class="btn btn-dn-coral">Đăng nhập</a>
                <a href="/register" class="btn btn-dn-outline">Tạo tài khoản</a>
            </div>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-warning">@error</div>
    }
    else if (scans.Count == 0)
    {
        <div class="dn-empty" data-reveal>
            <i class="ph ph-scan dn-empty-icon" aria-hidden="true"></i>
            <h5>Chưa có kết quả phân tích nào</h5>
            <p>Hãy scan da lần đầu để chúng tôi gợi ý routine và sản phẩm phù hợp với tình trạng da của bạn.</p>
            <a href="/scan" class="btn btn-dn-coral">Scan da ngay</a>
        </div>
    }
    else if (selected is not null)
    {
        <section class="dn-rec-summary" data-reveal>
            <div class="dn-rec-thumb">
                <img src="/skin-image/@selected.SkinImageId" alt="Ảnh scan da" loading="lazy" onerror="this.style.display='none'" />
                <i class="ph ph-user-focus" aria-hidden="true"></i>
            </div>
            <div class="dn-rec-info">
                <div class="dn-rec-meta">
                    <span><i class="ph ph-calendar-blank" aria-hidden="true"></i> @selected.DiagnosedAt.ToVn().ToString("dd/MM/yyyy HH:mm")</span>
                    @if (!string.IsNullOrWhiteSpace(selected.SkinType))
                    {
                        <span><i class="ph ph-stack" aria-hidden="true"></i> @selected.SkinType</span>
                    }
                </div>
                <h2>@selected.PrimaryCondition</h2>
                @if (!string.IsNullOrWhiteSpace(selected.Summary))
                {
                    <p>@selected.Summary</p>
                }
            </div>
            <div class="dn-rec-side">
                @if (selected.SkinHealthScore is { } score)
                {
                    <div class="dn-score @ScoreClass(score)"><small>Điểm da</small><b>@score</b><span>/100</span></div>
                }
                <a href="/diagnosis/@selected.SkinImageId" class="small fw-semibold">Xem kết quả chi tiết <i class="ph ph-arrow-right" aria-hidden="true"></i></a>
                @if (scans.Count > 1)
                {
                    <select class="form-select form-select-sm" value="@selected.Id" @onchange="OnScanChanged" aria-label="Chọn lần scan">
                        @foreach (var s in scans.Take(10))
                        {
                            <option value="@s.Id">@s.DiagnosedAt.ToVn().ToString("dd/MM/yyyy HH:mm") — @s.PrimaryCondition</option>
                        }
                    </select>
                }
            </div>
        </section>

        @if (loadingRecs)
        {
            <div class="dn-card p-5 text-center"><div class="spinner-border text-success" role="status"></div></div>
        }
        else if (recs.Count == 0)
        {
            <div class="dn-step-empty text-center">Chưa có sản phẩm phù hợp cho kết quả này. Hãy xem <a href="/products">toàn bộ sản phẩm</a>.</div>
        }
        else
        {
            <nav class="dn-stepnav" aria-label="Các bước routine">
                @foreach (var step in SkincareCatalog.Steps)
                {
                    <a href="#step-@step.Code" data-scroll title="@step.Label" class="@(recs.Any(r => r.Step == step.Number) ? "" : "is-empty")"><StepIcon Step="step.Number" />@step.Label</a>
                }
            </nav>

            @foreach (var step in SkincareCatalog.Steps)
            {
                var inStep = recs.Where(r => r.Step == step.Number).ToList();
                <section id="step-@step.Code" class="dn-step-section" data-reveal>
                    <div class="dn-step-head">
                        <StepIcon Step="step.Number" Illustration="true" />
                        <div>
                            <h2>@step.Label</h2>
                            <p>@step.Subtitle</p>
                        </div>
                        <span class="dn-step-when"><i class="ph ph-clock" aria-hidden="true"></i> @step.When</span>
                    </div>

                    @if (inStep.Count == 0)
                    {
                        <div class="dn-step-empty">Chưa có sản phẩm cho bước này phù hợp với làn da của bạn.</div>
                    }
                    else
                    {
                        <div class="dn-pgrid dn-pgrid-rec">
                            @for (var i = 0; i < inStep.Count; i++)
                            {
                                var item = inStep[i];
                                <div data-reveal style="--dn-delay:@(i * 70)ms">
                                    <ProductCard Product="item" OnOpen="TrackOpenAsync" />
                                </div>
                            }
                        </div>
                    }
                </section>
            }

            <p class="dn-disclaimer"><i class="ph ph-info" aria-hidden="true"></i> Gợi ý mang tính tham khảo từ AI, không thay thế tư vấn của bác sĩ da liễu.</p>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "diagnosis")] public Guid? DiagnosisId { get; set; }

    private List<DiagnosisDto> scans = [];
    private DiagnosisDto? selected;
    private List<ProductCardModel> recs = [];
    private bool loading = true;
    private bool loadingRecs;
    private bool needLogin;
    private bool spyStarted;
    private bool viewTracked;
    private string? error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // The layout loads the session in parallel; make sure it is ready before deciding who is here.
            if (!Session.IsAuthenticated)
            {
                try { await Session.LoadAsync(); } catch { /* treated as signed out */ }
            }

            if (!Session.IsAuthenticated)
            {
                needLogin = true;
                loading = false;
                StateHasChanged();
                return;
            }

            try
            {
                scans = await Api.GetHistoryTypedAsync();
                selected = scans.FirstOrDefault(s => s.Id == DiagnosisId) ?? scans.FirstOrDefault();
                loading = false;
                StateHasChanged();

                if (selected is not null) await LoadRecommendationsAsync(selected.Id);
            }
            catch (Exception ex)
            {
                error = $"Không tải được gợi ý: {ex.Message}";
                loading = false;
                StateHasChanged();
            }

            return;
        }

        if (!loadingRecs && recs.Count > 0 && !spyStarted)
        {
            spyStarted = true;
            try { await JS.InvokeVoidAsync("dnScrollSpy.start", ".dn-stepnav"); } catch { }
        }
    }

    private async Task LoadRecommendationsAsync(Guid diagnosisId)
    {
        loadingRecs = true;
        spyStarted = false;
        StateHasChanged();

        try
        {
            recs = (await Api.GetRecommendationsAsync(diagnosisId))
                .Select(ProductCardModel.FromRecommendation)
                .OfType<ProductCardModel>()
                .OrderBy(r => r.Step)
                .ThenByDescending(r => r.MatchPercentage)
                .ToList();
            error = null;

            if (!viewTracked)
            {
                viewTracked = true;
                await Analytics.EventAsync("view_recommendation", new { source = "personalised" });
            }
        }
        catch (Exception ex)
        {
            recs = [];
            error = $"Không tải được gợi ý: {ex.Message}";
        }
        finally
        {
            loadingRecs = false;
            StateHasChanged();
        }
    }

    private async Task OnScanChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var id)) return;
        selected = scans.FirstOrDefault(s => s.Id == id);
        if (selected is not null) await LoadRecommendationsAsync(selected.Id);
    }

    private async Task TrackOpenAsync(ProductCardModel item)
    {
        await Analytics.EventAsync("select_item", new { item_id = item.Id?.ToString(), item_name = item.Name, destination = "shopee" });
        await Analytics.EventAsync("affiliate_click", new { item_id = item.Id?.ToString(), item_name = item.Name, item_category = item.Category });
    }

    private static string ScoreClass(int score) => score >= 80 ? "good" : score >= 65 ? "mid" : "low";

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("dnScrollSpy.stop"); } catch { /* circuit may already be gone */ }
    }
}
