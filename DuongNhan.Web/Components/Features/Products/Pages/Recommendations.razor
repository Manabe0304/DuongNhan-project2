@page "/products"
@page "/recommendations"
@implements IAsyncDisposable
@inject DuongNhanApiService Api
@inject NavigationManager NavManager
@inject BrowserStorage Storage
@inject AnalyticsService Analytics
@inject IJSRuntime JS

<PageTitle>Gợi ý chăm sóc da theo bước &amp; loại da — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <section class="dn-reco-hero" data-reveal="zoom">
        <span class="dn-kicker">Dermacare</span>
        <h1>@(view == View.Steps ? "Routine chăm sóc da theo từng bước" : "Sản phẩm chăm sóc da")</h1>
        <p>Chọn loại da của bạn, chúng tôi sắp xếp sản phẩm theo đúng thứ tự: làm sạch → điều trị → tinh chất → dưỡng ẩm → chống nắng.</p>
    </section>

    <div class="d-flex flex-wrap gap-3 justify-content-between align-items-center mb-3" data-reveal>
        <div class="dn-chips" role="group" aria-label="Loại da">
            <button type="button" class="dn-chip-skin" aria-pressed="@(skinType is null ? "true" : "false")" @onclick="() => SelectSkinTypeAsync(null)">Tất cả loại da</button>
            @foreach (var t in SkincareCatalog.SkinTypes)
            {
                var code = t.Code;
                <button type="button" class="dn-chip-skin" aria-pressed="@(skinType == code ? "true" : "false")" @onclick="() => SelectSkinTypeAsync(code)">@t.Label</button>
            }
        </div>
        <div class="d-flex flex-wrap gap-2 align-items-center">
            <div class="dn-search"><input class="form-control" placeholder="Tìm sản phẩm..." @bind="query" @bind:event="oninput" aria-label="Tìm sản phẩm" /></div>
            <div class="dn-viewtoggle" role="group" aria-label="Kiểu hiển thị">
                <button type="button" aria-pressed="@(view == View.Steps ? "true" : "false")" @onclick="() => SetViewAsync(View.Steps)">Theo bước</button>
                <button type="button" aria-pressed="@(view == View.All ? "true" : "false")" @onclick="() => SetViewAsync(View.All)">Tất cả</button>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="dn-card p-5 text-center"><div class="spinner-border text-success"></div></div>
    }
    else if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="alert alert-warning">@error</div>
    }
    else if (view == View.Steps)
    {
        <nav class="dn-stepnav" aria-label="Các bước routine">
            @foreach (var step in SkincareCatalog.Steps)
            {
                <a href="#step-@step.Number" data-scroll><b>@step.Number</b>@step.Label</a>
            }
        </nav>

        @foreach (var step in SkincareCatalog.Steps)
        {
            var inStep = Filtered.Where(p => p.Step == step.Number).ToList();
            <section id="step-@step.Number" class="dn-step-section" data-reveal>
                <div class="dn-step-head">
                    <img src="/images/step-@(step.Code).svg" alt="" loading="lazy" />
                    <div>
                        <span class="dn-step-num">Bước @step.Number</span>
                        <h2>@step.Label</h2>
                        <p>@step.Subtitle</p>
                    </div>
                    <span class="dn-step-when"><i class="ph ph-clock" aria-hidden="true"></i> @step.When</span>
                </div>

                @if (inStep.Count == 0)
                {
                    <div class="dn-step-empty">
                        @(skinType is null
                            ? "Chưa có sản phẩm cho bước này."
                            : $"Chưa có sản phẩm cho bước này phù hợp {SkincareCatalog.SkinTypeLabel(skinType).ToLowerInvariant()}.")
                    </div>
                }
                else
                {
                    <div class="row g-4">
                        @for (var i = 0; i < inStep.Count; i++)
                        {
                            var item = inStep[i];
                            <div class="col-sm-6 col-xl-3" data-reveal style="--dn-delay:@(i % 4 * 70)ms">
                                @ProductCard(item)
                            </div>
                        }
                    </div>
                }
            </section>
        }

        @if (Filtered.Count == 0)
        {
            <div class="dn-step-empty text-center">Không tìm thấy sản phẩm nào khớp bộ lọc. Hãy thử chọn “Tất cả loại da”.</div>
        }
    }
    else
    {
        @if (Filtered.Count == 0)
        {
            <div class="dn-step-empty text-center">Không tìm thấy sản phẩm nào khớp bộ lọc.</div>
        }
        <div class="row g-4">
            @for (var i = 0; i < Filtered.Count; i++)
            {
                var item = Filtered[i];
                <div class="col-sm-6 col-xl-3" data-reveal style="--dn-delay:@(i % 4 * 70)ms">
                    @ProductCard(item)
                </div>
            }
        </div>
    }
</div>

@code {
    private const string SkinTypeKey = "dn.skin_type";
    private const string FallbackImage = "https://images.unsplash.com/photo-1556228720-195a672e8a03?w=600";

    private enum View { Steps, All }

    private sealed record Item(
        Guid? Id, string Name, string Brand, string Category, string Price,
        string Image, string Affiliate, string SkinTypes, int Step, string Rating);

    private List<Item> items = [];
    private string query = "";
    private string? skinType;
    private View view;
    private bool loading = true;
    private string? error;
    private bool spyStarted;
    private bool trackedView;

    private List<Item> Filtered => items
        .Where(p => SkincareCatalog.SuitsSkinType(p.SkinTypes, skinType))
        .Where(p => string.IsNullOrWhiteSpace(query)
            || p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
            || p.Brand.Contains(query, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.Step).ThenBy(p => p.Name)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        // /recommendations opens the routine view; /products keeps the plain catalogue grid.
        var path = new Uri(NavManager.Uri).AbsolutePath;
        view = path.StartsWith("/recommendations", StringComparison.OrdinalIgnoreCase) ? View.Steps : View.All;

        try
        {
            var raw = await Api.GetProductsAsync();
            items = raw.Select(Parse).ToList();
        }
        catch (Exception ex) { error = $"Không tải được sản phẩm từ Product API: {ex.Message}"; }
        finally { loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Browser storage is only readable after the first interactive render.
            try
            {
                var saved = await Storage.GetAsync(SkinTypeKey);
                if (SkincareCatalog.SkinTypes.Any(t => t.Code == saved))
                {
                    skinType = saved;
                    StateHasChanged();
                }
            }
            catch { /* optional convenience */ }
        }

        if (!loading && error is null && !trackedView && view == View.Steps)
        {
            trackedView = true;
            await Analytics.EventAsync("view_recommendation", new { source = "routine_steps" });
        }

        if (view == View.Steps && !loading && error is null && !spyStarted)
        {
            spyStarted = true;
            try { await JS.InvokeVoidAsync("dnScrollSpy.start", ".dn-stepnav"); } catch { }
        }
    }

    private async Task SelectSkinTypeAsync(string? code)
    {
        skinType = code;
        try
        {
            if (code is null) await Storage.RemoveAsync(SkinTypeKey);
            else await Storage.SetAsync(SkinTypeKey, code);
        }
        catch { /* not persisting is fine */ }
    }

    private async Task SetViewAsync(View next)
    {
        if (view == next) return;
        view = next;
        spyStarted = false;
        if (next == View.All) { try { await JS.InvokeVoidAsync("dnScrollSpy.stop"); } catch { } }
    }

    private async Task OpenAsync(Item item)
    {
        await Analytics.EventAsync("select_item", new { item_id = item.Id?.ToString(), item_name = item.Name, destination = "shopee" });
        await Analytics.EventAsync("affiliate_click", new { item_id = item.Id?.ToString(), item_name = item.Name, item_category = item.Category });

        if (!string.IsNullOrWhiteSpace(item.Affiliate) && item.Affiliate != "#")
            NavManager.NavigateTo(item.Affiliate, forceLoad: true);
    }

    private RenderFragment ProductCard(Item p) => @<div class="dn-product-card h-100">
        <div class="dn-product-img">
            <img src="@p.Image" alt="@p.Name" loading="lazy" onerror="this.onerror=null;this.src='/images/step-serum.svg'" />
            <div class="dn-product-tags">
                <span class="dn-tag">Bước @p.Step</span>
                @foreach (var code in p.SkinTypes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).Take(2))
                {
                    <span class="dn-tag">@SkincareCatalog.SkinTypeLabel(code)</span>
                }
            </div>
        </div>
        <div class="p-3 d-flex flex-column">
            <small class="text-secondary">@p.Brand</small>
            <h6 class="mt-1 mb-2">@p.Name</h6>
            <div class="d-flex align-items-center justify-content-between mb-3">
                <span class="fw-bold">@p.Price</span>
                <span class="small dn-rating"><i class="ph-fill ph-star" aria-hidden="true"></i>@p.Rating</span>
            </div>
            <button type="button" @onclick="() => OpenAsync(p)" class="btn btn-dn-coral btn-sm mt-auto">Xem sản phẩm</button>
        </div>
    </div>;

    private static Item Parse(System.Text.Json.JsonElement e)
    {
        var category = Text(e, "category", "");
        var step = Int(e, "step") ?? SkincareCatalog.StepForCategory(category);
        return new Item(
            Id: Guid.TryParse(Text(e, "id", ""), out var id) ? id : null,
            Name: Text(e, "name", "Skin care product"),
            Brand: Text(e, "brand", "DuongNhan"),
            Category: category,
            Price: FormatPrice(e),
            Image: Text(e, "imageUrl", Text(e, "image", FallbackImage)) is { Length: > 0 } img ? img : FallbackImage,
            Affiliate: Text(e, "affiliateUrl", "#"),
            SkinTypes: SkincareCatalog.NormalizeSkinTypes(Text(e, "skinType", "")),
            Step: Math.Clamp(step, SkincareCatalog.MinStep, SkincareCatalog.MaxStep),
            Rating: Text(e, "rating", "4.8"));
    }

    private static string FormatPrice(System.Text.Json.JsonElement e)
    {
        foreach (var key in new[] { "price", "Price" })
        {
            if (e.TryGetProperty(key, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetDecimal(out var d))
                return d <= 0 ? "Liên hệ" : d.ToString("N0", System.Globalization.CultureInfo.InvariantCulture).Replace(',', '.') + " ₫";
        }
        return "—";
    }

    private static string Text(System.Text.Json.JsonElement item, string name, string fallback)
    {
        foreach (var key in new[] { name, char.ToUpperInvariant(name[0]) + name[1..] })
            if (item.TryGetProperty(key, out var p) && p.ValueKind != System.Text.Json.JsonValueKind.Null)
                return p.ValueKind == System.Text.Json.JsonValueKind.String ? p.GetString() ?? fallback : p.ToString();
        return fallback;
    }

    private static int? Int(System.Text.Json.JsonElement item, string name)
    {
        foreach (var key in new[] { name, char.ToUpperInvariant(name[0]) + name[1..] })
            if (item.TryGetProperty(key, out var p) && p.ValueKind == System.Text.Json.JsonValueKind.Number && p.TryGetInt32(out var n))
                return n;
        return null;
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("dnScrollSpy.stop"); } catch { /* circuit may already be gone */ }
    }
}
