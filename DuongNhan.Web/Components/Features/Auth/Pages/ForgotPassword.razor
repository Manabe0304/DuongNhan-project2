@page "/forgot-password"
@page "/auth/forgot-password"
@inject DuongNhanApiService Api
@inject NavigationService Navigation

<div class="dn-auth-page">
    <div class="dn-auth-form-wrap">
        <div class="dn-auth-form">
            <a href="/login" class="dn-link small"><i class="ph ph-arrow-left" aria-hidden="true"></i>Quay lại đăng nhập</a>
            <span class="dn-kicker mt-4">Bảo mật</span>
            <h1>Quên mật khẩu?</h1>
            <p class="text-secondary small">Nhập email của bạn và chúng tôi sẽ gửi mã OTP để đặt lại mật khẩu.</p>

            @if (sent)
            {
                <div class="alert alert-success d-flex align-items-center gap-2">
                    <i class="ph ph-check-circle fs-5" aria-hidden="true"></i>
                    <span>Mã OTP đã được gửi đến <strong>@email</strong>. Kiểm tra hộp thư của bạn.</span>
                </div>
                <a href="/verify-email?email=@Uri.EscapeDataString(email)&mode=reset" class="btn btn-dn-coral btn-lg w-100 mt-2">
                    <i class="ph ph-envelope-open" aria-hidden="true"></i> Nhập mã OTP
                </a>
                <button class="btn btn-dn-outline w-100 mt-2" @onclick="Reset" disabled="@loading">
                    Gửi lại mã
                </button>
            }
            else
            {
                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger small">@error</div>
                }

                <form @onsubmit="Submit" @onsubmit:preventDefault>
                    <div class="mb-4">
                        <label>Email đăng ký</label>
                        <input class="form-control form-control-lg" type="email" @bind="email" required
                               placeholder="name@example.com" autofocus />
                    </div>
                    <button class="btn btn-dn-coral btn-lg w-100" disabled="@loading" id="btn-send-otp">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Đang gửi...</span>
                        }
                        else
                        {
                            <i class="ph ph-paper-plane-tilt" aria-hidden="true"></i>
                            <span>Gửi mã OTP</span>
                        }
                    </button>
                </form>
            }

            <div class="text-center small text-secondary mt-4">
                Nhớ ra mật khẩu rồi? <a href="/login" class="fw-semibold text-dark">Đăng nhập</a>
            </div>
        </div>
    </div>
</div>

@code {
    private string email = "";
    private bool loading;
    private bool sent;
    private string? error;

    private async Task Submit()
    {
        error = null;
        loading = true;
        try
        {
            var ok = await Api.SendOtpAsync(email.Trim());
            if (ok)
                sent = true;
            else
                error = "Không thể gửi mã OTP. Hãy kiểm tra lại địa chỉ email.";
        }
        catch (Exception ex)
        {
            error = $"Lỗi: {ex.Message}";
        }
        finally { loading = false; }
    }

    private void Reset()
    {
        sent = false;
        error = null;
    }
}
