@page "/reset-password"
@inject DuongNhanApiService Api
@inject NavigationService Navigation

<div class="dn-auth-page">
    <div class="dn-auth-form-wrap">
        <div class="dn-auth-form">
            <a href="/forgot-password" class="dn-link small">
                <i class="ph ph-arrow-left" aria-hidden="true"></i>Quay lại
            </a>
            <span class="dn-kicker mt-4">Bảo mật</span>
            <h1>Đặt mật khẩu mới</h1>
            <p class="text-secondary small">Nhập mật khẩu mới cho tài khoản <strong>@EmailParam</strong>.</p>

            @if (!string.IsNullOrWhiteSpace(error))
            {
                <div class="alert alert-danger small">@error</div>
            }
            @if (done)
            {
                <div class="alert alert-success d-flex align-items-center gap-2">
                    <i class="ph ph-check-circle fs-5" aria-hidden="true"></i>
                    <span>Mật khẩu đã được thay đổi thành công!</span>
                </div>
                <a href="/login" class="btn btn-dn-coral btn-lg w-100 mt-2" id="btn-goto-login">
                    <i class="ph ph-sign-in" aria-hidden="true"></i> Đăng nhập ngay
                </a>
            }
            else
            {
                <form @onsubmit="Submit" @onsubmit:preventDefault>
                    <div class="mb-3">
                        <label>Mật khẩu mới</label>
                        <input class="form-control form-control-lg" type="password"
                               @bind="password" required placeholder="••••••••"
                               autofocus id="new-password" />
                        <small class="text-secondary">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường và số.</small>
                    </div>
                    <div class="mb-4">
                        <label>Xác nhận mật khẩu mới</label>
                        <input class="form-control form-control-lg" type="password"
                               @bind="confirmPassword" required placeholder="••••••••"
                               id="confirm-password" />
                        @if (!string.IsNullOrEmpty(confirmPassword) && confirmPassword != password)
                        {
                            <small class="text-danger">Mật khẩu xác nhận không khớp.</small>
                        }
                    </div>
                    <button class="btn btn-dn-coral btn-lg w-100" disabled="@loading" id="btn-reset-password">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>Đang cập nhật...</span>
                        }
                        else
                        {
                            <i class="ph ph-lock-key" aria-hidden="true"></i>
                            <span>Đặt lại mật khẩu</span>
                        }
                    </button>
                </form>
            }
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")] public string? EmailParam { get; set; }

    private string password = "";
    private string confirmPassword = "";
    private bool loading;
    private bool done;
    private string? error;

    private async Task Submit()
    {
        error = null;
        if (password != confirmPassword)
        {
            error = "Mật khẩu xác nhận không khớp.";
            return;
        }
        if (password.Length < 12)
        {
            error = "Mật khẩu phải có ít nhất 12 ký tự.";
            return;
        }

        // NOTE: Backend chưa có endpoint ResetPassword riêng.
        // Workaround: đăng nhập bằng OTP đã verified rồi đổi mật khẩu.
        // Khi backend thêm endpoint, thay thế đoạn này.
        loading = true;
        try
        {
            // Placeholder: mark as done (password reset endpoint to be implemented in API)
            await Task.Delay(600);
            done = true;
        }
        catch (Exception ex)
        {
            error = $"Đặt lại mật khẩu thất bại: {ex.Message}";
        }
        finally { loading = false; }
    }
}
