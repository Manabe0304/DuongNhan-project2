@implements IDisposable
@inject AuthModalService Modal
@inject DuongNhanApiService Api
@inject UiSessionService Session
@inject NavigationService Navigation
@inject IJSRuntime JS
@inject IConfiguration Configuration

@if (Modal.IsOpen)
{
    <div class="dn-modal-backdrop" @onclick="Modal.Close">
        <div class="dn-modal dn-auth-modal" @onclick:stopPropagation="true">
            <button type="button" class="dn-modal-close" @onclick="Modal.Close" aria-label="Đóng">
                <i class="ph ph-x" aria-hidden="true"></i>
            </button>

            @if (stage == Stage.Otp)
            {
                <div class="text-center mb-4">
                    <h2 class="h5 fw-bold mb-1">Xác minh email của bạn</h2>
                    <p class="text-secondary small mb-0">Nhập mã 6 số vừa được gửi tới <strong>@email</strong>.</p>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger small">@error</div>
                }
                @if (!string.IsNullOrWhiteSpace(info))
                {
                    <div class="alert alert-success small">@info</div>
                }

                <form @onsubmit="SubmitOtp" @onsubmit:preventDefault>
                    <div class="mb-3">
                        <input class="form-control form-control-lg text-center" style="letter-spacing:.4em;font-weight:700"
                               maxlength="6" inputmode="numeric" placeholder="••••••"
                               @bind="otpCode" @bind:event="oninput" required />
                    </div>
                    <button class="btn btn-dn-coral btn-lg w-100" disabled="@loading">
                        @(loading ? "Đang xác minh..." : "Xác minh")
                    </button>
                </form>

                <div class="text-center small text-secondary mt-3">
                    Không nhận được mã?
                    <button type="button" class="btn btn-link btn-sm p-0 align-baseline" @onclick="SendOtp" disabled="@loading">Gửi lại</button>
                </div>
                <div class="text-center small mt-2">
                    <button type="button" class="btn btn-link btn-sm p-0 text-secondary" @onclick="SkipOtp">Để sau, vào trang cá nhân</button>
                </div>
            }
            else
            {
                <div class="text-center mb-4">
                    <h2 class="h5 fw-bold mb-1">@(isRegister ? "Tạo Tài Khoản Mới" : "Đăng Nhập Dưỡng Nhan")</h2>
                    <p class="text-secondary small mb-0">
                        @(isRegister
                            ? "Đăng ký để lưu trữ hồ sơ và phác đồ chăm sóc lâu dài"
                            : "Đăng nhập để xem lịch sử quét và tiếp tục theo dõi tiến trình")
                    </p>
                </div>

                @if (!string.IsNullOrWhiteSpace(error))
                {
                    <div class="alert alert-danger small">@error</div>
                }

                <div id="dn-google-btn" class="dn-google-slot" @key="isRegister"></div>
                @if (googleStatus is not null and not "ok")
                {
                    <div class="alert alert-warning small mt-2 mb-0">@GoogleStatusMessage</div>
                }

                <div class="dn-divider"><span>Hoặc dùng Email</span></div>

                <form @onsubmit="SubmitForm" @onsubmit:preventDefault>
                    @if (isRegister)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Họ và tên</label>
                            <input class="form-control" type="text" @bind="displayName" required placeholder="Nguyễn Văn A" />
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Địa chỉ Email</label>
                        <input class="form-control" type="email" @bind="email" required placeholder="email@example.com" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Mật khẩu</label>
                        <input class="form-control" type="password" @bind="password" required placeholder="••••••••" />
                        @if (isRegister)
                        {
                            <small class="text-secondary">Tối thiểu 12 ký tự, gồm chữ hoa, chữ thường và số.</small>
                        }
                    </div>

                    @if (isRegister)
                    {
                        <div class="mb-3">
                            <label class="form-label small fw-semibold">Xác nhận mật khẩu</label>
                            <input class="form-control" type="password" @bind="confirmPassword" required placeholder="••••••••" />
                            @if (!string.IsNullOrEmpty(confirmPassword) && confirmPassword != password)
                            {
                                <small class="text-danger">Mật khẩu xác nhận không khớp.</small>
                            }
                        </div>
                    }

                    <button type="submit" class="btn btn-dn-coral btn-lg w-100 mt-2" disabled="@loading">
                        @(loading ? "Đang xử lý..." : isRegister ? "Đăng Ký Tài Khoản" : "Đăng Nhập")
                    </button>
                </form>

                <div class="text-center small mt-4 pt-3 border-top">
                    <button type="button" class="btn btn-link btn-sm fw-semibold" @onclick="ToggleMode">
                        @(isRegister ? "Đã có tài khoản? Đăng nhập ngay" : "Chưa có tài khoản? Đăng ký miễn phí")
                    </button>
                </div>
            }
        </div>
    </div>
}

@code {
    private enum Stage { Form, Otp }

    private Stage stage = Stage.Form;
    private bool isRegister;
    private bool wasOpen;

    private string displayName = "";
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string otpCode = "";

    private bool loading;
    private string? error;
    private string? info;

    private DotNetObjectReference<AuthModal>? selfReference;

    protected override void OnInitialized()
    {
        selfReference = DotNetObjectReference.Create(this);
        Modal.Changed += HandleModalChanged;
    }

    private void HandleModalChanged()
    {
        if (Modal.IsOpen && !wasOpen)
        {
            // Just opened: reset the form to a clean slate in whichever mode was requested.
            isRegister = Modal.IsRegisterMode;
            stage = Stage.Form;
            displayName = email = password = confirmPassword = otpCode = "";
            error = info = null;
            googleStatus = null;
            googleRenderedForRegister = null;
        }
        wasOpen = Modal.IsOpen;
        InvokeAsync(StateHasChanged);
    }

    private void ToggleMode()
    {
        isRegister = !isRegister;
        error = null;
    }

    private async Task SubmitForm()
    {
        error = null;

        if (isRegister && password != confirmPassword)
        {
            error = "Mật khẩu xác nhận không khớp.";
            return;
        }

        loading = true;
        try
        {
            var result = isRegister
                ? await Api.RegisterAsync(displayName.Trim(), email.Trim(), password)
                : await Api.LoginAsync(email.Trim(), password);

            if (string.IsNullOrWhiteSpace(result.AccessToken))
            {
                error = "API không trả về access token. Hãy kiểm tra Auth API.";
                return;
            }

            await Session.SignInAsync(result.UserName ?? email.Split('@')[0], result.Email ?? email, result.AccessToken, result.RefreshToken);

            if (isRegister)
            {
                // New accounts get an OTP step right away; login skips straight through.
                await SendOtp();
                stage = Stage.Otp;
            }
            else
            {
                Modal.Close();
                Navigation.NavigateTo("/dashboard");
            }
        }
        catch (Exception ex)
        {
            error = $"{(isRegister ? "Đăng ký" : "Đăng nhập")} thất bại: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private string? googleStatus;
    private bool? googleRenderedForRegister;

    private string GoogleStatusMessage => googleStatus == "not-configured"
        ? "Đăng nhập Google chưa được cấu hình: hãy đặt Google:ClientId trong DuongNhan.Web/appsettings.json."
        : "Không tải được Google Sign-In. Hãy kiểm tra kết nối mạng hoặc tiện ích chặn quảng cáo.";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!Modal.IsOpen || stage != Stage.Form)
        {
            googleRenderedForRegister = null;
            return;
        }

        if (googleRenderedForRegister == isRegister) return;
        googleRenderedForRegister = isRegister;

        try
        {
            var clientId = Configuration["Google:ClientId"] ?? "";
            var status = await JS.InvokeAsync<string>(
                "dnGoogleAuth.renderButton",
                "dn-google-btn",
                clientId,
                selfReference,
                isRegister ? "signup_with" : "signin_with",
                336);

            if (status != googleStatus)
            {
                googleStatus = status;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            googleStatus = "script-blocked";
            error ??= $"Không thể mở đăng nhập Google: {ex.Message}";
            StateHasChanged();
        }
    }

    /// <summary>Invoked from wwwroot/js/google-auth.js once Google returns a signed ID token.</summary>
    [JSInvokable]
    public async Task OnGoogleCredential(string idToken)
    {
        loading = true;
        error = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await Api.GoogleLoginAsync(idToken);
            if (string.IsNullOrWhiteSpace(result.AccessToken))
            {
                error = "Đăng nhập Google thất bại: API không trả về access token.";
                return;
            }

            await Session.SignInAsync(result.UserName ?? "Người dùng Google", result.Email ?? "", result.AccessToken, result.RefreshToken);
            Modal.Close();
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            error = $"Đăng nhập Google thất bại: {ex.Message}";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SendOtp()
    {
        try
        {
            var sent = await Api.SendOtpAsync(email.Trim());
            if (sent)
            {
                error = null;
                info = $"Mã xác minh đã được gửi tới {email.Trim()}. Hãy kiểm tra hộp thư (kể cả mục Spam).";
            }
            else
            {
                info = null;
                error = "Không gửi được email xác minh lúc này. Vui lòng thử lại sau.";
            }
        }
        catch
        {
            info = null;
            error = "Không gửi được email xác minh lúc này. Vui lòng thử lại sau.";
        }
    }

    private async Task SubmitOtp()
    {
        error = null;
        loading = true;
        try
        {
            var verified = await Api.VerifyOtpAsync(email.Trim(), otpCode.Trim());
            if (!verified)
            {
                error = "Mã xác minh không đúng hoặc đã hết hạn.";
                return;
            }

            info = "Xác minh thành công!";
            Modal.Close();
            Navigation.NavigateTo("/dashboard");
        }
        catch (Exception ex)
        {
            error = $"Xác minh thất bại: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void SkipOtp()
    {
        Modal.Close();
        Navigation.NavigateTo("/dashboard");
    }

    public void Dispose()
    {
        Modal.Changed -= HandleModalChanged;
        selfReference?.Dispose();
    }
}
