@page "/subscription/usage"
@inject DuongNhanApiService Api
<div class="container dn-container dn-page"><div class="dn-page-heading"><span class="dn-kicker">Usage</span><h1>Giới hạn sử dụng</h1><p>Theo dõi số lượt phân tích còn lại.</p></div><div class="dn-card p-4 p-lg-5"><div class="d-flex justify-content-between"><b>AI Skin Scan</b><span>@used / @limit</span></div><div class="progress mt-3" style="height:10px"><div class="progress-bar bg-success" style="width:@Percent%"></div></div><small class="text-secondary d-block mt-2">Dữ liệu được lấy từ Subscription API.</small></div></div>
@code{private int used,limit=3;private int Percent=>limit<=0?0:Math.Min(100,used*100/limit);protected override async Task OnInitializedAsync(){try{var x=await Api.GetUsageAsync();if(x is { } j){used=Num(j,"scansUsed","used");limit=Num(j,"scansLimit","limit");}}catch{}}private static int Num(System.Text.Json.JsonElement j,string a,string b){foreach(var k in new[]{a,char.ToUpper(a[0])+a[1..],b,char.ToUpper(b[0])+b[1..]})if(j.TryGetProperty(k,out var p)&&p.TryGetInt32(out var n))return n;return 0;}}
