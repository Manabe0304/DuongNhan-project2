@page "/subscription/usage"
@using System.Text.Json
@inject DuongNhanApiService Api

<PageTitle>Gói hiện tại — Dưỡng Nhan</PageTitle>

<div class="container dn-container dn-page">
    <div class="dn-page-heading">
        <span class="dn-kicker">Usage</span>
        <h1>Giới hạn sử dụng</h1>
        <p>Theo dõi số lượt phân tích còn lại.</p>
    </div>

    <div class="dn-card p-4 p-lg-5">
        <div class="d-flex justify-content-between">
            <b>AI Skin Scan</b>
            <span>@used / @limit</span>
        </div>
        <div class="progress mt-3" style="height:10px">
            <div class="progress-bar bg-success" style="width:@(Percent)%" role="progressbar" aria-valuenow="@Percent" aria-valuemin="0" aria-valuemax="100"></div>
        </div>
        <small class="text-secondary d-block mt-2">Dữ liệu được lấy từ Subscription API.</small>
    </div>
</div>

@code {
    private int used;
    private int limit = 15;

    private int Percent => limit <= 0 ? 0 : Math.Min(100, Math.Max(0, (int)Math.Round((double)used * 100 / limit)));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetUsageAsync();
            if (result is JsonElement json)
            {
                used = GetJsonInt(json, "scansUsed", "used");
                limit = GetJsonInt(json, "scansLimit", "limit");
            }
        }
        catch
        {
            // Fallback to default values on API failure
        }
    }

    private static int GetJsonInt(JsonElement json, string primaryProp, string fallbackProp)
    {
        string[] candidates =
        {
            primaryProp,
            char.ToUpperInvariant(primaryProp[0]) + primaryProp[1..],
            fallbackProp,
            char.ToUpperInvariant(fallbackProp[0]) + fallbackProp[1..]
        };

        foreach (var key in candidates)
        {
            if (json.TryGetProperty(key, out var prop) && prop.TryGetInt32(out var value))
            {
                return value;
            }
        }

        return 0;
    }
}
