@inherits LayoutComponentBase

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <span class="me-3">Hello, @context.User.Identity?.Name</span>
                    <a href="/profile">Profile</a>
                    <a href="/logout" class="ms-3">Log out</a>
                </Authorized>
                <NotAuthorized>
                    <a href="/login">Log in</a>
                    <a href="/register" class="ms-3">Register</a>
                </NotAuthorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<ToastContainer />