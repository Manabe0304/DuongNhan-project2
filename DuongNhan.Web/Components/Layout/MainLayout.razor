@inherits LayoutComponentBase
@implements IDisposable
@inject NavigationManager NavManager
@inject UiSessionService Session
@inject NavigationService Navigation
@inject DuongNhanApiService Api
@inject AuthModalService AuthModalState

<div class="dn-app">
    @if (Session.IsAuthenticated)
    {
        <div class="dn-shell">
            <NavMenu IsOpen="isSidebarOpen" OnClose="CloseSidebar" />

            <div class="dn-shell-main">
                <header class="dn-app-topbar">
                    <div class="d-flex align-items-center gap-2 min-w-0">
                        <button type="button" class="dn-sidebar-toggle d-lg-none" @onclick="OpenSidebar" aria-label="Mở menu điều hướng">
                            <i class="ph ph-list" aria-hidden="true"></i>
                        </button>
                        <div class="min-w-0">
                            <span class="dn-app-topbar-crumb d-none d-sm-inline">Dưỡng Nhan /</span>
                            <h2 class="dn-app-topbar-title text-truncate">@PageTitle</h2>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2">
                        @if (usageLimit > 0)
                        {
                            <a href="/pricing" class="dn-usage-pill d-none d-md-inline-flex">
                                <span class="dn-dot"></span>
                                <span>Lượt quét: <strong>@usageUsed/@usageLimit</strong></span>
                            </a>
                        }

                        <a href="/scan" class="btn-dn-coral dn-btn rounded-pill px-3 py-2">
                            <i class="ph ph-sparkle" aria-hidden="true"></i>
                            <span class="d-none d-sm-inline">Scan da mới</span>
                        </a>

                        <a href="/profile" class="dn-profile-pill @(IsCurrentPath("/profile") ? "active" : string.Empty)">
                            <span class="dn-user-avatar">@Initials</span>
                            <span class="d-none d-sm-inline">@(Session.Name ?? "Tài khoản")</span>
                        </a>
                    </div>
                </header>

                <main class="dn-main">
                    @Body
                </main>

                <Footer />
            </div>
        </div>
    }
    else
    {
        <header class="dn-topbar">
            <div class="container-fluid dn-container d-flex align-items-center justify-content-between gap-3">
                <a class="dn-brand" href="/">
                    <img class="dn-brand-mark" src="/DuongNhan.jpg" />
                    <span class="d-inline-flex align-items-center gap-2">
                        <span>Dưỡng Nhan</span>
                        <span class="dn-brand-badge">AI</span>
                    </span>
                </a>

                <nav class="dn-main-nav d-none d-lg-flex" aria-label="Điều hướng chính">
                    <a href="/" class="@NavClass("/")"><i class="ph ph-house" aria-hidden="true"></i>Trang chủ</a>
                    <a href="/scan" class="@NavClass("/scan")"><i class="ph ph-sparkle" aria-hidden="true"></i>AI Scan Da</a>
                    <a href="/products" class="@NavClass("/products")">
                        <i class="ph ph-shopping-bag" aria-hidden="true"></i>Sản phẩm
                        <span class="dn-nav-badge">Shopee Mall</span>
                    </a>
                    <a href="/pricing" class="@NavClass("/pricing")"><i class="ph ph-seal-check" aria-hidden="true"></i>Bảng giá</a>
                </nav>

                <div class="d-flex align-items-center gap-2">
                    <button type="button" class="btn btn-dn-outline btn-sm dn-btn" @onclick="AuthModalState.OpenLogin">
                        <i class="ph ph-sign-in" aria-hidden="true"></i>Đăng nhập
                    </button>
                    <button type="button" class="btn btn-dn-coral btn-sm dn-btn" @onclick="AuthModalState.OpenRegister">
                        <i class="ph ph-user-plus" aria-hidden="true"></i>Đăng ký
                    </button>
                </div>
            </div>
        </header>

        <div class="dn-mobile-nav d-lg-none">
            <div class="container-fluid dn-container d-flex gap-1 overflow-auto py-2">
                <a href="/" class="dn-chip @(IsCurrentPath("/") ? "active" : string.Empty)"><i class="ph ph-house" aria-hidden="true"></i><span>Trang chủ</span></a>
                <a href="/scan" class="dn-chip @(IsCurrentPath("/scan") ? "active" : string.Empty)"><i class="ph ph-sparkle" aria-hidden="true"></i><span>AI Scan</span></a>
                <a href="/products" class="dn-chip @(IsCurrentPath("/products") ? "active" : string.Empty)"><i class="ph ph-shopping-bag" aria-hidden="true"></i><span>Sản phẩm</span></a>
                <a href="/pricing" class="dn-chip @(IsCurrentPath("/pricing") ? "active" : string.Empty)"><i class="ph ph-seal-check" aria-hidden="true"></i><span>Bảng giá</span></a>
            </div>
        </div>

        <main class="dn-main">
            @Body
        </main>

        <Footer />

        <AuthModal />
    }
</div>

<ToastContainer />

@code {
    private bool sessionLoaded;
#pragma warning disable CS0414
    private bool isSidebarOpen;
#pragma warning restore CS0414
    private int usageUsed;
    private int usageLimit;

    private string Initials
    {
        get
        {
            var name = Session.Name;
            return string.IsNullOrWhiteSpace(name) ? "U" : name[..1].ToUpperInvariant();
        }
    }

    private string PageTitle => Navigation.CurrentUrl switch
    {
        var u when u.Contains("/scan", StringComparison.OrdinalIgnoreCase) || u.Contains("/upload", StringComparison.OrdinalIgnoreCase) => "AI Scan Da",
        var u when u.Contains("/diagnosis", StringComparison.OrdinalIgnoreCase) => "Kết quả phân tích da",
        var u when u.Contains("/recommendations", StringComparison.OrdinalIgnoreCase) => "Gợi ý chăm sóc",
        var u when u.Contains("/products", StringComparison.OrdinalIgnoreCase) => "Sản phẩm & Shopee Mall",
        var u when u.Contains("/pricing", StringComparison.OrdinalIgnoreCase) => "Bảng giá gói quét",
        var u when u.Contains("/history", StringComparison.OrdinalIgnoreCase) => "Lịch sử phân tích",
        var u when u.Contains("/profile", StringComparison.OrdinalIgnoreCase) => "Hồ sơ cá nhân & Cài đặt",
        var u when u.Contains("/dashboard", StringComparison.OrdinalIgnoreCase) => "Bảng điều khiển",
        _ => "Dưỡng Nhan AI",
    };

    protected override void OnInitialized() => NavManager.LocationChanged += HandleLocationChanged;

    private void HandleLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        isSidebarOpen = false;
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose() => NavManager.LocationChanged -= HandleLocationChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || sessionLoaded) return;
        sessionLoaded = true;

        try
        {
            await Session.LoadAsync();
            await InvokeAsync(StateHasChanged);

            if (Session.IsAuthenticated)
            {
                var usage = await Api.GetUsageAsync();
                if (usage is { } u)
                {
                    usageUsed = ReadInt(u, "scansUsedThisMonth", "scansUsed", "used");
                    usageLimit = ReadInt(u, "scansLimit", "limit");
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch
        {
            // Session/usage details are cosmetic; a failure here must not break the shell.
        }
    }

    private string NavClass(string path)
        => IsCurrentPath(path) ? "active" : string.Empty;

    private bool IsCurrentPath(string path)
    {
        var current = new Uri(Navigation.CurrentUrl).AbsolutePath.TrimEnd('/');
        if (current.Length == 0) current = "/";
        return path == "/"
            ? current == "/"
            : current.Equals(path, StringComparison.OrdinalIgnoreCase)
              || current.StartsWith(path + "/", StringComparison.OrdinalIgnoreCase);
    }

    private void OpenSidebar() => isSidebarOpen = true;
    private Task CloseSidebar() { isSidebarOpen = false; return Task.CompletedTask; }

    private static int ReadInt(System.Text.Json.JsonElement j, params string[] keys)
    {
        foreach (var key in keys)
        {
            foreach (var candidate in new[] { key, char.ToUpperInvariant(key[0]) + key[1..] })
            {
                if (j.TryGetProperty(candidate, out var p) && p.TryGetInt32(out var n))
                    return n;
            }
        }
        return 0;
    }
}
