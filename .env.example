# =====================================================================
# DuongNhan - biến môi trường - file mẫu: copy thành ".env" rồi điền giá trị thật
# Quy ước .NET: dấu "__" (hai gạch dưới) tương đương dấu ":" trong appsettings.json
# Ví dụ: Jwt__Key  ==  Jwt:Key
# =====================================================================

# ---- Database (PostgreSQL) -------------------------------------------
# Khi chạy bằng Aspire AppHost thì giá trị này được AppHost tự inject, .env KHÔNG ghi đè.
# Dùng cho: dotnet ef / chạy ApiService độc lập.
ConnectionStrings__postgresdb=Host=localhost;Port=5432;Database=postgresdb;Username=postgres;Password=CHANGE_ME

# ---- JWT --------------------------------------------------------------
Jwt__Key=CHANGE_ME_AT_LEAST_32_CHARACTERS_RANDOM_STRING
Jwt__Issuer=https://duongnhan.local
Jwt__Audience=https://duongnhan.local

# ---- Google Sign-In (OAuth Client ID) ---------------------------------
# Dùng chung cho ApiService (xác thực id_token) và Web (nút đăng nhập)
Google__ClientId=YOUR_GOOGLE_OAUTH_CLIENT_ID.apps.googleusercontent.com

# ---- SMTP (gửi OTP qua email) -----------------------------------------
Smtp__Host=smtp.gmail.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__Username=your-account@gmail.com
Smtp__Password=REPLACE_WITH_APP_PASSWORD
Smtp__From=Dưỡng Nhan <your-account@gmail.com>

# ---- Web frontend ------------------------------------------------------
# URL của ApiService mà Web gọi tới. Bỏ trống/không khai báo => dùng service discovery của Aspire.
# Api__BaseUrl=https://localhost:7449
Analytics__Ga4MeasurementId=G-XXXXXXXXXX

# ---- Thanh toán chuyển khoản VietQR + SePay ---------------------------
# Thông tin ngân hàng nhận tiền. Số tài khoản và tên chủ tài khoản KHÔNG nằm trong appsettings.json: bắt buộc khai báo ở đây (và trên Railway)
# Payment__BankName=xxxxxx
# Payment__BankCode=xxxxxx
Payment__AccountNumber=
Payment__AccountName=
# Tiền tố nội dung chuyển khoản, phải trùng "Cấu trúc mã thanh toán" đã cài trong SePay
# Payment__CodePrefix=xxxx
# Khóa bí mật SePay gửi kèm webhook (header "Authorization: Apikey <khóa>"). Để trống = tắt webhook.
Payment__SepayApiKey=
# Mẫu URL ảnh QR (có sẵn số tiền + nội dung). Để trống = hiện khung giữ chỗ. Ví dụ:
# Payment__QrUrlTemplate=https://img.vietqr.io/image/{bank}-{account}-compact2.png?amount={amount}&addInfo={content}&accountName={name}
